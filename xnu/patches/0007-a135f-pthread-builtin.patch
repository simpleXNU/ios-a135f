diff --git a/bsd/conf/Makefile.template b/bsd/conf/Makefile.template
index 4b83160..6ab431e 100644
--- a/bsd/conf/Makefile.template
+++ b/bsd/conf/Makefile.template
@@ -44,6 +44,15 @@ CFLAGS+= -include meta_features.h -DDRIVER_PRIVATE \
         -Warray-bounds-pointer-arithmetic
 SFLAGS+= -include meta_features.h
 
+# This provider is built into A135F; other boards use their normal kext.
+ifeq ($(CURRENT_MACHINE_CONFIG),A135F)
+A135F_PTHREAD_ROOT = $(SRCROOT)/bsd/pthread/a135f_libpthread
+A135F_PTHREAD_INC = -I$(A135F_PTHREAD_ROOT) -I$(A135F_PTHREAD_ROOT)/private -I$(A135F_PTHREAD_ROOT)/include
+a135f_pthread_init.o_INCFLAGS = $(A135F_PTHREAD_INC)
+a135f_pthread_support.o_INCFLAGS = $(A135F_PTHREAD_INC)
+a135f_pthread_synch.o_INCFLAGS = $(A135F_PTHREAD_INC)
+endif
+
 #
 # Directories for mig generated files
 #

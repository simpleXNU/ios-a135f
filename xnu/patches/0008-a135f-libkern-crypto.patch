+#if defined(ARM64_BOARD_CONFIG_A135F)
+/*
+ * A135F has no corecrypto kext (g_crypto_funcs stays NULL). SHA-1 uses
+ * BearSSL's portable implementation (libkern/crypto/a135f_sha1.c), with
+ * SHA1_CTX carrying exactly its state: chaining value, byte count and the
+ * partial block, converted around each call like the corecrypto path does.
+ */
+#include "a135f_bearssl/inc/bearssl_hash.h"
+
+static void
+SHA1ToBr(SHA1_CTX *sha1_ctx, br_sha1_context *br_ctx)
+{
+	br_sha1_init(br_ctx);

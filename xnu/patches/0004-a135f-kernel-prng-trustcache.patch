diff --git a/osfmk/prng/prng_random.c b/osfmk/prng/prng_random.c
index c52f0ab..5356114 100644
--- a/osfmk/prng/prng_random.c
+++ b/osfmk/prng/prng_random.c
@@ -145,6 +145,140 @@ static struct {
 		     .strictFIPS = 0,
 	     }};
 
+#if defined(A135F)
+/*
+ * The corecrypto kext normally installs the kernel PRNG. A135F has no such
+ * kext: use the built-in HMAC-SHA256 DRBG, just as early_random does. A
+ * single mutex serializes generation and reseeding across all CPUs. This
+ * favors a small, auditable bring-up implementation over per-CPU scaling.
+ * This registers only the PRNG, not the unrelated g_crypto_funcs table.
+ */
+#include <kern/startup.h>
+
+static LCK_GRP_DECLARE(a135f_prng_group, "a135f-prng");
+static LCK_MTX_DECLARE(a135f_prng_lock, &a135f_prng_group);
+static struct cckprng_ctx a135f_prng_ctx;
+static const struct ccdrbg_nisthmac_custom a135f_prng_custom = {
+	.di = &ccsha256_ltc_di,
+	.strictFIPS = 0,
+};
+static cckprng_getentropy a135f_getentropy;
+static void *a135f_getentropy_arg;
+static unsigned a135f_max_ngens;
+static bool a135f_generators[MAX_CPUS];
+
+static struct ccdrbg_state *
+a135f_prng_state(struct cckprng_ctx *ctx)
+{
+	return (struct ccdrbg_state *)ctx->drbg_state;
+}
+
+static void
+a135f_prng_check(int status)
+{
+	if (status != CCDRBG_STATUS_OK) {
+		panic("A135F HMAC DRBG error %d", status);
+	}
+}
+
+static void
+a135f_prng_init_with_getentropy(struct cckprng_ctx *ctx, unsigned max_ngens,
+    size_t seed_nbytes, const void *seed, size_t nonce_nbytes, const void *nonce,
+    cckprng_getentropy getentropy, void *getentropy_arg)
+{
+	assert(max_ngens > 0 && max_ngens <= MAX_CPUS);
+	ccdrbg_factory_nisthmac(&ctx->drbg_info, &a135f_prng_custom);
+	assert(ctx->drbg_info.size <= sizeof(ctx->drbg_state));
+	const char ps[] = "xnu a135f kernel random";
+	a135f_prng_check(ccdrbg_init(&ctx->drbg_info, a135f_prng_state(ctx),
+	    seed_nbytes, seed, nonce_nbytes, nonce, sizeof(ps) - 1, ps));
+	a135f_getentropy = getentropy;
+	a135f_getentropy_arg = getentropy_arg;
+	a135f_max_ngens = max_ngens;
+}
+
+static void
+a135f_prng_init(struct cckprng_ctx *ctx, size_t seed_nbytes, const void *seed,
+    size_t nonce_nbytes, const void *nonce, cckprng_getentropy getentropy,
+    void *getentropy_arg)
+{
+	a135f_prng_init_with_getentropy(ctx, MAX_CPUS, seed_nbytes, seed,
+	    nonce_nbytes, nonce, getentropy, getentropy_arg);
+}
+
+static void
+a135f_prng_initgen(__unused struct cckprng_ctx *ctx, unsigned gen_idx)
+{
+	lck_mtx_lock(&a135f_prng_lock);
+	assert(gen_idx < a135f_max_ngens);
+	assert(!a135f_generators[gen_idx]);
+	a135f_generators[gen_idx] = true;
+	lck_mtx_unlock(&a135f_prng_lock);
+}
+
+static void
+a135f_prng_reseed(struct cckprng_ctx *ctx, size_t nbytes, const void *seed)
+{
+	lck_mtx_lock(&a135f_prng_lock);
+	a135f_prng_check(ccdrbg_reseed(&ctx->drbg_info, a135f_prng_state(ctx),
+	    nbytes, seed, 0, NULL));
+	lck_mtx_unlock(&a135f_prng_lock);
+}
+
+static void
+a135f_prng_refresh(struct cckprng_ctx *ctx)
+{
+	/* The entropy callback also uses try-lock; refresh must not wait. */
+	if (!lck_mtx_try_lock(&a135f_prng_lock)) {
+		return;
+	}
+	uint8_t entropy[CCKPRNG_ENTROPY_SIZE];
+	size_t nbytes = sizeof(entropy);
+	int32_t nsamples = a135f_getentropy(&nbytes, entropy, a135f_getentropy_arg);
+	if (nsamples < 0) {
+		panic("A135F PRNG entropy health test failed");
+	}
+	if (nsamples >= 256) {
+		assert(nbytes >= SEED_SIZE && nbytes <= sizeof(entropy));
+		a135f_prng_check(ccdrbg_reseed(&ctx->drbg_info, a135f_prng_state(ctx),
+		    nbytes, entropy, 0, NULL));
+	}
+	cc_clear(sizeof(entropy), entropy);
+	lck_mtx_unlock(&a135f_prng_lock);
+}
+
+static void
+a135f_prng_generate(struct cckprng_ctx *ctx, unsigned gen_idx,
+    size_t nbytes, void *out)
+{
+	assert(nbytes <= CCKPRNG_GENERATE_MAX_NBYTES);
+	lck_mtx_lock(&a135f_prng_lock);
+	assert(gen_idx < a135f_max_ngens && a135f_generators[gen_idx]);
+	a135f_prng_check(ccdrbg_generate(&ctx->drbg_info, a135f_prng_state(ctx),
+	    nbytes, out, 0, NULL));
+	lck_mtx_unlock(&a135f_prng_lock);
+}
+
+__startup_func
+static void
+a135f_prng_startup(void)
+{
+	/* Ensure the boot seed exists before registration erases the early DRBG. */
+	(void)early_random();
+	const struct cckprng_funcs funcs = {
+		.init = a135f_prng_init,
+		.initgen = a135f_prng_initgen,
+		.reseed = a135f_prng_reseed,
+		.refresh = a135f_prng_refresh,
+		.generate = a135f_prng_generate,
+		.init_with_getentropy = a135f_prng_init_with_getentropy,
+	};
+	register_and_init_prng(&a135f_prng_ctx, &funcs);
+	kprintf("A135F PRNG: HMAC-SHA256 registered\n");
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_FIRST, a135f_prng_startup);
+#endif /* A135F */
+
 static void read_erandom(void * buf, size_t nbytes);
 
 /*
@@ -339,12 +473,22 @@ int
 write_random(void * buffer, u_int numbytes)
 {
 	uint8_t seed[SHA256_DIGEST_LENGTH];
+#if defined(A135F)
+	/* Hash without depending on the absent corecrypto kext's dispatch table. */
+	const struct ccdigest_info *di = &ccsha256_ltc_di;
+	ccdigest_di_decl(di, ctx);
+	ccdigest_init(di, ctx);
+	ccdigest_update(di, ctx, numbytes, buffer);
+	ccdigest_final(di, ctx, seed);
+	ccdigest_di_clear(di, ctx);
+#else
 	SHA256_CTX ctx;
 
 	/* hash the input to minimize the time we need to hold the lock */
 	SHA256_Init(&ctx);
 	SHA256_Update(&ctx, buffer, numbytes);
 	SHA256_Final(seed, &ctx);
+#endif
 
 	prng_funcs.reseed(prng_ctx, sizeof(seed), seed);
 	cc_clear(sizeof(seed), seed);
diff --git a/osfmk/vm/vm_kern.c b/osfmk/vm/vm_kern.c
index 2927d4b..dfd6170 100644
--- a/osfmk/vm/vm_kern.c
+++ b/osfmk/vm/vm_kern.c
@@ -2439,22 +2439,68 @@ kmem_sizeclass_init(void)
 	}
 }
 
+#if defined(A135F)
+/*
+ * No corecrypto kext is loaded on A135F yet. The kmem RNG contract permits
+ * a non-cryptographic generator and requires lock-free generation. Keep
+ * allocator RNG state per CPU/sizeclass; seed it from XNU's built-in early
+ * HMAC-SHA256 DRBG during single-CPU initialization.
+ *
+ * SplitMix64: Sebastiano Vigna, 2015, public-domain reference:
+ * https://prng.di.unimi.it/splitmix64.c
+ * This is private to kmem; it does not register or replace crypto services.
+ */
+struct a135f_kmem_rng {
+	uint64_t state;
+};
+
+static uint64_t
+a135f_kmem_random64(struct a135f_kmem_rng *rng)
+{
+	uint64_t value = (rng->state += 0x9e3779b97f4a7c15ULL);
+	value = (value ^ (value >> 30)) * 0xbf58476d1ce4e5b9ULL;
+	value = (value ^ (value >> 27)) * 0x94d049bb133111ebULL;
+	return value ^ (value >> 31);
+}
+
+static uint64_t
+a135f_kmem_uniform(struct a135f_kmem_rng *rng, uint64_t bound)
+{
+	assert(bound != 0);
+	/* Reject the incomplete residue interval to avoid modulo bias. */
+	const uint64_t threshold = -bound % bound;
+	uint64_t value;
+	do {
+		value = a135f_kmem_random64(rng);
+	} while (value < threshold);
+	return value % bound;
+}
+#endif /* A135F */
+
 /*
  * This is done during EARLY_BOOT as it needs the corecrypto module to be
- * set up.
+ * set up on platforms that use it for allocator randomness.
  */
 __startup_func
 static void
 kmem_crypto_init(void)
 {
+#if defined(A135F)
+	vm_size_t ctx_size = sizeof(struct a135f_kmem_rng);
+#else
 	vm_size_t ctx_size = crypto_random_kmem_ctx_size();
+#endif
 
 	for (uint32_t i = 0; i < KMEM_NUM_SIZECLASS; i++) {
 		struct kmem_sizeclass *ks = &kmem_size_array[i];
 
 		ks->ks_rng_ctx = zalloc_percpu_permanent(ctx_size, ZALIGN_PTR);
 		zpercpu_foreach(ctx, ks->ks_rng_ctx) {
+#if defined(A135F)
+			((struct a135f_kmem_rng *)ctx)->state = early_random();
+#else
 			crypto_random_kmem_init(ctx);
+#endif
 		}
 	}
 }
@@ -2711,17 +2757,20 @@ kmem_get_next_slot(
 	assert(num_slots > 0);

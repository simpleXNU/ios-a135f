+	// a135f_gicd_base is 0 only before the boot processor initializes it.
+	// Avoid the (not thread-safe) SecureDT* routines on secondary processors.
+	if (!a135f_gicd_base) {
+		DTEntry entry;
+		void const *prop;
+		unsigned int prop_size;

+
+#if defined(A135F)
+/*
+ * The A13 firmware starts a secondary with the real MPIDR (MT set, core in Aff1) which differs from the
+ * PSCI id in the device tree; reset_vector matches MPIDR against cpu_phys_id, so A135FCPU::startCPU
+ * stores the MPIDR it learned from the core's trampoline here before releasing the core.
+ */
+void a135f_set_cpu_phys_id(int cpu, uint32_t id);
+void
+a135f_set_cpu_phys_id(int cpu, uint32_t id)
+{
+	cpu_data_t *cdp = cpu_datap(cpu);
+	cdp->cpu_phys_id = id;
+	CleanPoC_DcacheRegion((vm_offset_t)cdp, sizeof(*cdp));
+}
+#endif

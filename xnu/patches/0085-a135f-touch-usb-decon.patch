diff --git a/bsd/dev/a135f_touch.c b/bsd/dev/a135f_touch.c
index 4ba6025..8220720 100644
--- a/bsd/dev/a135f_touch.c
+++ b/bsd/dev/a135f_touch.c
@@ -1,26 +1,675 @@
 /*
- * Touchscreen for the Galaxy A13: placeholder.
+ * Touchscreen for the Galaxy A13: Omnivision/Synaptics TCM "TD4150" TDDI over
+ * SPI, polled. Simplest possible port of the mainline-style ovt_tcm driver:
  *
- * The panel's controller (Omnivision/Synaptics TCM "TD4150" TDDI) is a SPI
- * part (USI_CMGP0 / spi_1, 0x11d00000, CS gpm3-0, IRQ gpa0-0, mode 3,
- * <= 7 MHz) that needs its firmware downloaded by the host on every cold
- * boot ("zeroflash"). That needs the vendor ovt_tcm protocol sources and the
- * firmware image, which this tree does not have yet. Until a driver exists
- * the HID touch service stays idle (the volume keys still work).
+ *  - USI_CMGP0 (0x11d00000) is switched to SPI mode and clocked from the CMU_CMGP
+ *    RCO (49.152 MHz / 2 -> SCK 6.1 MHz, below the 7 MHz limit), pins gpm0-0..3-0
+ *    muxed to function 2, chip select gpm3-0 driven as a plain GPIO, SPI mode 3.
+ *  - The controller is "zeroflash": if it identifies as ROM bootloader, the
+ *    application firmware (ROMBOOT_APP_CODE area, extracted and CRC-checked by
+ *    tools/mkadt.py from the vendor image, property "firmware" of /a135f-touch)
+ *    is downloaded with CMD_ROMBOOT_DOWNLOAD and started.
+ *  - Reports are fetched by polling the attention line (gpa0-0, active low) every
+ *    few ms; the touch report is decoded with the controller's own report-config
+ *    bytecode and handed to a135f_hid_touch() in 1080x2408 panel pixels.
  *
- * The driver should feed the HID layer with
- *     void a135f_hid_touch(int finger, int down, int x, int y);
- * using coordinates in the 1080x2408 panel space.
+ * The panel reset line is shared with the display and is NOT toggled; the supply
+ * (LDO28) is assumed to be left on by the bootloader. Nothing here writes
+ * anything outside the SPI/USI/CMU/pinctrl blocks listed above.
  */
 #if defined(ARM64_BOARD_CONFIG_A135F)
 #include <sys/param.h>
 #include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <kern/kalloc.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
 
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void a135f_hid_touch(int finger, int down, int x, int y);
+extern kern_return_t thread_terminate(thread_t);
 void a135f_touch_init(void);
 
+#define CMU_CMGP_PA     0x11c00000u
+#define SYSREG_CMGP_PA  0x11c20000u
+#define PINCTRL_CMGP_PA 0x11c30000u
+#define PINCTRL_ALIVE_PA 0x11850000u
+#define SPI_PA          0x11d00000u     /* SPI regs; USI block at +0xc0 */
+
+/* CMU_CMGP (clk-exynos850.c): mux/div/gates; bit 16 = busy, gate enable = bit 21 */
+#define CMU_MUX_USI0    0x1004
+#define CMU_DIV_USI0    0x1804
+#define CMU_GAT_USI0_IP 0x2044
+#define CMU_GAT_USI0_P  0x2048
+#define CMU_BUSY        (1u << 16)
+#define CMU_GATE_EN     (1u << 21)
+#define SYSREG_USI0_CONF 0x2000         /* USIv2 SW_CONF: BIT(1) = SPI */
+#define USI_CON         0xc4            /* SPI_PA + 0xc0 + 0x04 */
+
+/* S3C64xx SPI (drivers/spi/spi-s3c64xx.c), Exynos850 flavour */
+#define SPI_CH_CFG      0x00
+#define SPI_MODE_CFG    0x08
+#define SPI_CS_REG      0x0c
+#define SPI_INT_EN      0x10
+#define SPI_STATUS      0x14
+#define SPI_TX_DATA     0x18
+#define SPI_RX_DATA     0x1c
+#define SPI_PACKET_CNT  0x20
+#define SPI_PENDING_CLR 0x24
+#define SPI_SWAP_CFG    0x28
+#define CH_SW_RST       (1u << 5)
+#define CH_CPOL         (1u << 3)
+#define CH_CPHA         (1u << 2)
+#define CH_RXON         (1u << 1)
+#define CH_TXON         (1u << 0)
+#define CS_SIG_INACT    (1u << 0)
+#define PKT_EN          (1u << 16)
+#define ST_RX_LVL(s)    (((s) >> 15) & 0x1ff)
+#define ST_TX_LVL(s)    (((s) >> 6) & 0x1ff)
+#define ST_TX_DONE      (1u << 25)
+#define SPI_CHUNK       63              /* FIFO depth 64 - 1, as the Linux driver */
+
+/* TCM protocol (see ovt_tcm) */
+#define TCM_MARKER      0xa5
+#define TCM_PADDING     0x5a
+#define TCM_MIN_READ    9
+#define TCM_MAX_MSG     2048
+#define TCM_CMD_CONTINUE_WRITE  0x01
+#define TCM_CMD_IDENTIFY        0x02
+#define TCM_CMD_RESET           0x04
+#define TCM_CMD_RUN_APP_FW      0x14
+#define TCM_CMD_GET_APP_INFO    0x20
+#define TCM_CMD_GET_REPORT_CFG  0x25
+#define TCM_CMD_ROMBOOT_RUN_BL  0x42
+#define TCM_CMD_ROMBOOT_DOWNLOAD 0x45
+#define TCM_ST_OK               0x01
+#define TCM_ST_CONTINUED_READ   0x03
+#define TCM_REPORT_IDENTIFY     0x10
+#define TCM_REPORT_TOUCH        0x11
+#define TCM_MODE_APP            0x01
+#define TCM_MODE_HDL            0x02
+#define TCM_MODE_ROMBOOT        0x04
+#define TCM_FW_RESERVED         14
+#define TCM_MAX_OBJECTS         10
+
+/* touch report bytecode */
+#define TT_END          0x00
+#define TT_FOREACH_ACTIVE 0x01
+#define TT_FOREACH      0x02
+#define TT_FOREACH_END  0x03
+#define TT_PAD          0x04
+#define TT_OBJ_INDEX    0x06
+#define TT_OBJ_CLASS    0x07
+#define TT_OBJ_X        0x08
+#define TT_OBJ_Y        0x09
+#define TT_OBJ_Z        0x0a
+#define TT_NUM_ACTIVE   0x18
+
+#define PANEL_W         1080
+#define PANEL_H         2408
+
+static vm_offset_t spi, cmu, sysreg, pinc, alive;
+static uint8_t msg[TCM_MAX_MSG + 8];
+static uint8_t resp[TCM_MAX_MSG + 8];
+static unsigned resp_len;
+static unsigned read_len = TCM_MIN_READ;
+static unsigned wr_chunk;
+static uint8_t id_mode, id_valid;
+static uint8_t report_cfg[256];
+static unsigned report_cfg_len, max_x, max_y, max_objects;
+static bool touch_started;
+static int touch_chan;
+
+static inline uint32_t rd32(vm_offset_t b, uint32_t o) { return *(volatile uint32_t *)(b + o); }
+static inline void wr32(vm_offset_t b, uint32_t o, uint32_t v) { *(volatile uint32_t *)(b + o) = v; }
+
+static void
+wait_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&touch_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+cmu_wait(uint32_t off)
+{
+	for (int i = 0; i < 10000 && (rd32(cmu, off) & CMU_BUSY); i++) {
+		delay(1);
+	}
+}
+
+static void
+pin_func(uint32_t bank, unsigned pin, unsigned func)
+{
+	uint32_t con = rd32(pinc, bank);
+	con &= ~(0xfu << (pin * 4));
+	con |= (func & 0xfu) << (pin * 4);
+	wr32(pinc, bank, con);
+	/* no pull, drive strength LV1 (value 0) */
+	wr32(pinc, bank + 0x08, rd32(pinc, bank + 0x08) & ~(3u << (pin * 2)));
+	wr32(pinc, bank + 0x0c, rd32(pinc, bank + 0x0c) & ~(3u << (pin * 2)));
+}
+
+static void
+cs(bool active)
+{
+	uint32_t d = rd32(pinc, 0x60 + 4);
+	wr32(pinc, 0x60 + 4, active ? (d & ~1u) : (d | 1u));    /* gpm3-0, active low */
+	delay(2);
+}
+
+static bool
+attn(void)
+{
+	return !(rd32(alive, 0x04) & 1u);       /* gpa0-0 DAT, active low */
+}
+
+static int
+spi_run(const uint8_t *tx, uint8_t *rx, unsigned len)
+{
+	while (len) {
+		unsigned n = MIN(len, SPI_CHUNK);
+		wr32(spi, SPI_CH_CFG, CH_CPOL | CH_CPHA | CH_SW_RST);
+		wr32(spi, SPI_CH_CFG, CH_CPOL | CH_CPHA);
+		wr32(spi, SPI_PENDING_CLR, 0x1f);
+		wr32(spi, SPI_PACKET_CNT, PKT_EN | n);
+		wr32(spi, SPI_CH_CFG, CH_CPOL | CH_CPHA | CH_RXON | CH_TXON);
+		for (unsigned i = 0; i < n; i++) {
+			*(volatile uint8_t *)(spi + SPI_TX_DATA) = tx ? tx[i] : 0xff;
+		}
+		unsigned spins = 0;
+		while (ST_RX_LVL(rd32(spi, SPI_STATUS)) < n) {
+			if (++spins > 200000) {
+				wr32(spi, SPI_CH_CFG, CH_CPOL | CH_CPHA);
+				return ETIMEDOUT;
+			}
+			delay(1);
+		}
+		for (unsigned i = 0; i < n; i++) {
+			uint8_t b = *(volatile uint8_t *)(spi + SPI_RX_DATA);
+			if (rx) {
+				rx[i] = b;
+			}
+		}
+		for (spins = 0; spins < 100000; spins++) {
+			uint32_t st = rd32(spi, SPI_STATUS);
+			if (!ST_TX_LVL(st) && (st & ST_TX_DONE)) {
+				break;
+			}
+			delay(1);
+		}
+		wr32(spi, SPI_CH_CFG, CH_CPOL | CH_CPHA);
+		wr32(spi, SPI_PACKET_CNT, 0);
+		if (tx) {
+			tx += n;
+		}
+		if (rx) {
+			rx += n;
+		}
+		len -= n;
+	}
+	return 0;
+}
+
+static int
+spi_write_msg(const uint8_t *buf, unsigned len)
+{
+	cs(true);
+	int e = spi_run(buf, NULL, len);
+	cs(false);
+	return e;
+}
+
+static int
+spi_read_msg(uint8_t *buf, unsigned len)
+{
+	cs(true);
+	int e = spi_run(NULL, buf, len);
+	cs(false);
+	return e;
+}
+
+static int
+spi_hw_init(void)
+{
+	/* CMU_CMGP: USI0 from the 49.152 MHz RCO, divide by 2, gates on */
+	wr32(cmu, CMU_MUX_USI0, 0);
+	cmu_wait(CMU_MUX_USI0);
+	wr32(cmu, CMU_DIV_USI0, 1);
+	cmu_wait(CMU_DIV_USI0);
+	wr32(cmu, CMU_GAT_USI0_P, rd32(cmu, CMU_GAT_USI0_P) | CMU_GATE_EN);
+	wr32(cmu, CMU_GAT_USI0_IP, rd32(cmu, CMU_GAT_USI0_IP) | CMU_GATE_EN);
+	/* USI: SPI mode, out of reset */
+	wr32(sysreg, SYSREG_USI0_CONF, (1u << 1));
+	wr32(spi, USI_CON, rd32(spi, USI_CON) & ~1u);
+	delay(5);
+	/* pins: gpm0-0..gpm2-0 SPI function; gpm3-0 = chip select as GPIO output, deasserted */
+	for (unsigned b = 0; b < 3; b++) {
+		pin_func(b * 0x20, 0, 2);
+	}
+	wr32(pinc, 0x60 + 4, rd32(pinc, 0x60 + 4) | 1u);
+	pin_func(0x60, 0, 1);
+	/* gpa0-0 (attention) as input */
+	wr32(alive, 0, rd32(alive, 0) & ~0xfu);
+	/* controller setup: 8 bit, mode 3, no swap, no DMA, no interrupts */
+	wr32(spi, SPI_MODE_CFG, 0);
+	wr32(spi, SPI_CS_REG, CS_SIG_INACT);
+	wr32(spi, SPI_INT_EN, 0);
+	wr32(spi, SPI_SWAP_CFG, 0);
+	wr32(spi, SPI_CH_CFG, CH_CPOL | CH_CPHA);
+	return 0;
+}
+
+/* ---- TCM message layer ---- */
+
+static unsigned
+le2(const uint8_t *p)
+{
+	return p[0] | (p[1] << 8);
+}
+
+/* Read one message if the attention line is asserted. Returns 1 with code/payload set, 0 none, <0 error. */
+static int
+tcm_read(uint8_t *code, uint8_t **payload, unsigned *plen)
+{
+	int e = spi_read_msg(msg, read_len);
+	if (e) {
+		return -e;
+	}
+	if (msg[0] != TCM_MARKER) {
+		return 0;
+	}
+	*code = msg[1];
+	unsigned len = le2(&msg[2]);
+	unsigned total = 4 + len + 1;
+	if (total > TCM_MAX_MSG) {
+		return -EIO;
+	}
+	if (*code == 0x00 || *code == 0x02 || *code == TCM_ST_CONTINUED_READ) {
+		return 0;       /* idle / busy / out-of-sync continuation: nothing to dispatch */
+	}
+	if (total > read_len + 1) {
+		unsigned rem = total - read_len;
+		static uint8_t tmp[TCM_MAX_MSG + 8];
+		e = spi_read_msg(tmp, rem + 2);
+		if (e) {
+			return -e;
+		}
+		if (tmp[0] != TCM_MARKER || tmp[1] != TCM_ST_CONTINUED_READ) {
+			return -EIO;
+		}
+		memcpy(&msg[read_len], &tmp[2], rem);
+	} else if (total == read_len + 1) {
+		msg[total - 1] = TCM_PADDING;
+	}
+	if (msg[total - 1] != TCM_PADDING) {
+		return -EIO;
+	}
+	read_len = MAX(TCM_MIN_READ, MIN(total, (unsigned)TCM_MAX_MSG));
+	*payload = &msg[4];
+	*plen = len;
+	return 1;
+}
+
+static void touch_parse(const uint8_t *report, unsigned report_len);
+
+/* Wait up to ms for the response to `cmd`. Reports arriving meanwhile are handled. */
+static int
+tcm_wait(uint8_t cmd, unsigned ms)
+{
+	bool reboots = cmd == TCM_CMD_RESET || cmd == TCM_CMD_IDENTIFY || cmd == TCM_CMD_RUN_APP_FW ||
+	    cmd == TCM_CMD_ROMBOOT_RUN_BL;
+	for (unsigned t = 0; t < ms; t += 2) {
+		if (attn()) {
+			uint8_t code, *p;
+			unsigned plen;
+			int r = tcm_read(&code, &p, &plen);
+			if (r < 0) {
+				return -r;
+			}
+			if (r == 1) {
+				if (code == TCM_REPORT_IDENTIFY) {
+					id_mode = plen > 1 ? p[1] : 0;
+					id_valid = 1;
+					if (plen >= 24) {
+						wr_chunk = MIN(le2(&p[22]), 512u);
+					}
+					if (reboots) {
+						memcpy(resp, p, MIN(plen, (unsigned)sizeof(resp)));
+						resp_len = plen;
+						return 0;
+					}
+				} else if (code == TCM_REPORT_TOUCH) {
+					touch_parse(p, plen);
+				} else if (code < TCM_REPORT_IDENTIFY) {
+					if (code != TCM_ST_OK) {
+						printf("A135F TOUCH: cmd 0x%x failed, status 0x%x\n", cmd, code);
+						return EIO;
+					}
+					memcpy(resp, p, MIN(plen, (unsigned)sizeof(resp)));
+					resp_len = plen;
+					return 0;
+				}
+			}
+		}
+		delay(2000);
+	}
+	printf("A135F TOUCH: timeout waiting for cmd 0x%x\n", cmd);
+	return ETIMEDOUT;
+}
+
+static int
+tcm_cmd(uint8_t cmd, const uint8_t *payload, unsigned length, unsigned timeout_ms)
+{
+	unsigned remaining = length + 2, chunk_space, chunks;
+	if (cmd == TCM_CMD_ROMBOOT_DOWNLOAD) {
+		chunk_space = remaining;
+	} else {
+		chunk_space = wr_chunk ? wr_chunk - 1 : remaining;
+	}
+	chunks = MAX(1u, (remaining + chunk_space - 1) / chunk_space);
+	uint8_t *out = kalloc_data(chunk_space + 1, Z_WAITOK | Z_ZERO);
+	if (!out) {
+		return ENOMEM;
+	}
+	int e = 0;
+	for (unsigned idx = 0; idx < chunks && !e; idx++) {
+		unsigned xfer = MIN(remaining, chunk_space);
+		if (idx == 0) {
+			out[0] = cmd;
+			out[1] = (uint8_t)length;
+			out[2] = (uint8_t)(length >> 8);
+			if (xfer > 2 && length) {
+				memcpy(&out[3], payload, xfer - 2);
+			}
+		} else {
+			out[0] = TCM_CMD_CONTINUE_WRITE;
+			memcpy(&out[1], payload + (idx * chunk_space - 2), xfer);
+		}
+		e = spi_write_msg(out, xfer + 1);
+		remaining -= xfer;
+		if (chunks > 1) {
+			delay(700);
+		}
+	}
+	kfree_data(out, chunk_space + 1);
+	if (e) {
+		return e;
+	}
+	return tcm_wait(cmd, timeout_ms);
+}
+
+static int
+tcm_identify(void)
+{
+	id_valid = 0;
+	int e = tcm_cmd(TCM_CMD_IDENTIFY, NULL, 0, 1000);
+	if (!e && !id_valid) {
+		e = EIO;
+	}
+	return e;
+}
+
+static int
+tcm_start(const uint8_t *fw, unsigned fw_len)
+{
+	int e;
+	/* drain whatever the controller announced after power-up */
+	for (int i = 0; i < 8 && attn(); i++) {
+		uint8_t code, *p;
+		unsigned plen;
+		if (tcm_read(&code, &p, &plen) == 1 && code == TCM_REPORT_IDENTIFY && plen > 1) {
+			id_mode = p[1];
+			id_valid = 1;
+		}
+	}
+	if ((e = tcm_identify()) != 0) {
+		return e;
+	}
+	printf("A135F TOUCH: controller mode 0x%x\n", id_mode);
+	if (id_mode == TCM_MODE_ROMBOOT) {
+		if (!fw || !fw_len) {
+			printf("A135F TOUCH: zeroflash controller needs firmware (ADT /a135f-touch \"firmware\"); touch disabled\n");
+			return ENOENT;
+		}
+		unsigned out_len = TCM_FW_RESERVED + fw_len;
+		uint8_t *out = kalloc_data(out_len, Z_WAITOK | Z_ZERO);
+		if (!out) {
+			return ENOMEM;
+		}
+		out[0] = (uint8_t)(fw_len >> 16);
+		memcpy(out + TCM_FW_RESERVED, fw, fw_len);
+		printf("A135F TOUCH: downloading %u byte application firmware\n", fw_len);
+		e = tcm_cmd(TCM_CMD_ROMBOOT_DOWNLOAD, out, out_len, 10000);
+		kfree_data(out, out_len);
+		if (e) {
+			return e;
+		}
+		if ((e = tcm_cmd(TCM_CMD_ROMBOOT_RUN_BL, NULL, 0, 1000)) != 0) {
+			return e;
+		}
+		wait_ms(200);
+		if ((e = tcm_identify()) != 0) {
+			return e;
+		}
+	}
+	if (id_mode != TCM_MODE_APP && id_mode != TCM_MODE_HDL) {
+		if ((e = tcm_cmd(TCM_CMD_RUN_APP_FW, NULL, 0, 1000)) != 0) {
+			return e;
+		}
+		wait_ms(200);
+		if ((e = tcm_identify()) != 0) {
+			return e;
+		}
+		if (id_mode != TCM_MODE_APP && id_mode != TCM_MODE_HDL) {
+			printf("A135F TOUCH: stuck in mode 0x%x\n", id_mode);
+			return ENODEV;
+		}
+	}
+	if ((e = tcm_cmd(TCM_CMD_GET_APP_INFO, NULL, 0, 1000)) != 0) {
+		return e;
+	}
+	if (resp_len < 38) {
+		return EIO;
+	}
+	/* struct tcm_app_info: customer_config_id[16] ends at 32; max_x 32, max_y 34, max_objects 36 */
+	max_x = le2(&resp[32]);
+	max_y = le2(&resp[34]);
+	max_objects = MIN(le2(&resp[36]), (unsigned)TCM_MAX_OBJECTS);
+	if (!max_x || !max_y || !max_objects) {
+		printf("A135F TOUCH: implausible app info %ux%u/%u\n", max_x, max_y, max_objects);
+		return EINVAL;
+	}
+	if ((e = tcm_cmd(TCM_CMD_GET_REPORT_CFG, NULL, 0, 1000)) != 0) {
+		return e;
+	}
+	if (!resp_len || resp_len > sizeof(report_cfg)) {
+		return EIO;
+	}
+	memcpy(report_cfg, resp, resp_len);
+	report_cfg_len = resp_len;
+	printf("A135F TOUCH: TD4150 ready: %ux%u, %u objects\n", max_x, max_y, max_objects);
+	return 0;
+}
+
+/* ---- touch report decoding (bytecode in report_cfg) ---- */
+
+static unsigned
+get_bits(const uint8_t *r, unsigned rlen, unsigned off, unsigned bits)
+{
+	unsigned val = 0, got = 0;
+	if (!bits || bits > 32 || off + bits > rlen * 8) {
+		return 0;
+	}
+	unsigned byte = off / 8, bit = off % 8;
+	while (got < bits) {
+		unsigned take = MIN(8 - bit, bits - got);
+		unsigned b = (r[byte] >> bit) & ((1u << take) - 1);
+		val |= b << got;
+		got += take;
+		bit = 0;
+		byte++;
+	}
+	return val;
+}
+
+struct tobj { unsigned status, x, y, z; };
+
+static void
+touch_parse(const uint8_t *report, unsigned rlen)
+{
+	static bool down[TCM_MAX_OBJECTS];
+	struct tobj o[TCM_MAX_OBJECTS];
+	unsigned idx = 0, offset = 0, obj = 0, next = 0, active_seen = 0, num_active = 0, end_of_foreach = 0;
+	bool active_only = false, have_num = false;
+
+	if (!report_cfg_len) {
+		return;
+	}
+	bzero(o, sizeof(o));
+	while (idx < report_cfg_len) {
+		uint8_t code = report_cfg[idx++];
+		unsigned bits, data;
+		switch (code) {
+		case TT_END:
+			goto done;
+		case TT_FOREACH_ACTIVE:
+			obj = 0; next = idx; active_only = true;
+			break;
+		case TT_FOREACH:
+			obj = 0; next = idx; active_only = false;
+			break;
+		case TT_FOREACH_END:
+			end_of_foreach = idx;
+			if (active_only) {
+				if (have_num) {
+					if (++active_seen < num_active) {
+						idx = next;
+					}
+				} else if (offset < rlen * 8) {
+					idx = next;
+				}
+			} else if (++obj < max_objects) {
+				idx = next;
+			}
+			break;
+		case TT_PAD:
+			offset = (offset + 7) & ~7u;
+			break;
+		case TT_OBJ_INDEX:
+			bits = report_cfg[idx++];
+			obj = get_bits(report, rlen, offset, bits);
+			offset += bits;
+			break;
+		case TT_OBJ_CLASS: case TT_OBJ_X: case TT_OBJ_Y: case TT_OBJ_Z:
+			bits = report_cfg[idx++];
+			data = get_bits(report, rlen, offset, bits);
+			if (obj < max_objects) {
+				if (code == TT_OBJ_CLASS) { o[obj].status = data; }
+				else if (code == TT_OBJ_X) { o[obj].x = data; }
+				else if (code == TT_OBJ_Y) { o[obj].y = data; }
+				else { o[obj].z = data; }
+			}
+			offset += bits;
+			break;
+		case TT_NUM_ACTIVE:
+			bits = report_cfg[idx++];
+			num_active = get_bits(report, rlen, offset, bits);
+			have_num = true;
+			offset += bits;
+			if (!num_active) {
+				if (!end_of_foreach) {
+					goto done;
+				}
+				idx = end_of_foreach;
+			}
+			break;
+		default:
+			bits = report_cfg[idx++];
+			offset += bits;
+			break;
+		}
+	}
+done:
+	for (unsigned i = 0; i < max_objects; i++) {
+		bool fing = o[i].status == 1 || o[i].status == 2;
+		if (fing) {
+			int px = (int)((uint64_t)MIN(o[i].x, max_x) * (PANEL_W - 1) / max_x);
+			int py = (int)((uint64_t)MIN(o[i].y, max_y) * (PANEL_H - 1) / max_y);
+			a135f_hid_touch((int)i, 1, px, py);
+			down[i] = true;
+		} else if (down[i]) {
+			a135f_hid_touch((int)i, 0, 0, 0);
+			down[i] = false;
+		}
+	}
+}
+
+static void
+touch_thread(void *arg, wait_result_t result)
+{
+	const uint8_t *fw = NULL;
+	unsigned fw_len = 0;
+	DTEntry node;
+	void const *prop;
+	unsigned int size;
+	(void)arg;
+	(void)result;
+
+	if (SecureDTLookupEntry(NULL, "/a135f-touch", &node) == kSuccess &&
+	    SecureDTGetProperty(node, "firmware", &prop, &size) == kSuccess) {
+		fw = prop;
+		fw_len = size;
+	}
+	if (tcm_start(fw, fw_len) != 0) {
+		printf("A135F TOUCH: bring-up failed; touch disabled\n");
+		thread_terminate(current_thread());
+		return;
+	}
+	for (;;) {
+		if (attn()) {
+			uint8_t code, *p;
+			unsigned plen;
+			int r = tcm_read(&code, &p, &plen);
+			if (r == 1 && code == TCM_REPORT_TOUCH) {
+				touch_parse(p, plen);
+			}
+		}
+		wait_ms(4);
+	}
+}
+
 void
 a135f_touch_init(void)
 {
-	printf("A135F TOUCH: no driver for the TD4150 SPI/TCM controller yet; touch disabled\n");
+	int enabled = 1;
+	thread_t thread;
+	if (touch_started) {
+		return;
+	}
+	touch_started = true;
+	(void)PE_parse_boot_argn("a135f_touch", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("A135F TOUCH: disabled (a135f_touch=0)\n");
+		return;
+	}
+	spi = ml_io_map(SPI_PA, 0x1000);
+	cmu = ml_io_map(CMU_CMGP_PA, 0x8000);
+	sysreg = ml_io_map(SYSREG_CMGP_PA, 0x4000);
+	pinc = ml_io_map(PINCTRL_CMGP_PA, 0x1000);
+	alive = ml_io_map(PINCTRL_ALIVE_PA, 0x1000);
+	if (!spi || !cmu || !sysreg || !pinc || !alive) {
+		printf("A135F TOUCH: MMIO mapping failed\n");
+		return;
+	}
+	spi_hw_init();
+	if (kernel_thread_start(touch_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
 }
 #endif /* ARM64_BOARD_CONFIG_A135F */

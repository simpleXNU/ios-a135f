+/*
+ * A135F: daemons started by launchd write stdout/stderr to /dev/null, and
+ * pointing a launchd job at /dev/console stops it from launching at all
+ * (backboardd, v8 image). Instead, what the processes named in boot-arg
+ * a135fnull (comma separated, default "backboardd,SpringBoard") write to
+ * /dev/null goes to the console (and so to the persistent log) as
+ * "|name| text". a135fnull=- turns it off.
+ */
+static char a135f_null_names[128];
+static int a135f_null_parsed;
+
+static bool
+a135f_null_tee(char *name, size_t len)
+{
+	if (!a135f_null_parsed) {
+		if (!PE_parse_boot_argn("a135fnull", a135f_null_names, sizeof(a135f_null_names))) {
+			strlcpy(a135f_null_names, "backboardd,SpringBoard", sizeof(a135f_null_names));
+		}
+		a135f_null_parsed = 1;
+	}
+	proc_selfname(name, (int)len);
+	size_t n = strlen(name);
+	for (const char *t = a135f_null_names; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && n > 0 && strncmp(t, name, n) == 0) {
+			return true;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}

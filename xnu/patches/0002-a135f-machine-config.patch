diff --git a/osfmk/arm64/kpc.c b/osfmk/arm64/kpc.c
new file mode 100644
index 0000000..fdd0a69
--- /dev/null
+++ b/osfmk/arm64/kpc.c
@@ -0,0 +1,159 @@
+/*
+ * a135f: arm64 kpc backend. Apple's osfmk/arm64/kpc.c programs the Apple
+ * PMU (implementation-defined system registers) and ships only in the KDK's
+ * closed per-SoC library. xnu does not build without kperf, and kperf needs
+ * kpc, so this backend reports no counters at all: every class is empty and
+ * every configuration request fails cleanly.
+ */
+
+#include <mach/mach_types.h>
+#include <machine/machine_routines.h>
+#include <kern/processor.h>
+#include <sys/errno.h>
+#include <kern/kpc.h>
+
+int kpc_pc_capture = 0;
+
+void
+kpc_arch_init(void)
+{
+}
+
+uint32_t
+kpc_get_classes(void)
+{
+	return 0;
+}
+
+int
+kpc_get_pmu_version(void)
+{
+	return KPC_PMU_ERROR;
+}
+
+uint32_t
+kpc_fixed_count(void)
+{
+	return 0;
+}
+
+uint32_t
+kpc_fixed_config_count(void)
+{
+	return 0;
+}
+
+uint64_t
+kpc_fixed_max(void)
+{
+	return 0;
+}
+
+uint32_t
+kpc_configurable_count(void)
+{
+	return 0;
+}
+
+uint32_t
+kpc_configurable_config_count(uint64_t pmc_mask __unused)
+{
+	return 0;
+}
+
+uint64_t
+kpc_configurable_max(void)
+{
+	return 0;
+}
+
+uint32_t
+kpc_rawpmu_config_count(void)
+{
+	return 0;
+}
+
+int
+kpc_get_rawpmu_config(kpc_config_t *configv __unused)
+{
+	return 0;
+}
+
+boolean_t
+kpc_is_running_fixed(void)
+{
+	return FALSE;
+}
+
+boolean_t
+kpc_is_running_configurable(uint64_t pmc_mask __unused)
+{
+	return FALSE;
+}
+
+int
+kpc_get_fixed_config(kpc_config_t *configv __unused)
+{
+	return 0;
+}
+
+int
+kpc_get_fixed_counters(uint64_t *counterv __unused)
+{
+	return 0;
+}
+
+int
+kpc_get_configurable_config(kpc_config_t *configv __unused, uint64_t pmc_mask __unused)
+{
+	return 0;
+}
+
+int
+kpc_get_configurable_counters(uint64_t *counterv __unused, uint64_t pmc_mask __unused)
+{
+	return 0;
+}
+
+int
+kpc_get_all_cpus_counters(uint32_t classes __unused, int *curcpu, uint64_t *buf __unused)
+{
+	if (curcpu) {
+		*curcpu = cpu_number();
+	}
+	return 0;
+}
+
+int
+kpc_set_config_arch(struct kpc_config_remote *mp_config __unused)
+{
+	return ENOTSUP;
+}
+
+int
+kpc_set_period_arch(struct kpc_config_remote *mp_config __unused)
+{
+	return ENOTSUP;
+}
+
+int
+kpc_set_running_arch(struct kpc_running_remote *mp_config __unused)
+{
+	return ENOTSUP;
+}
+
+int
+kpc_set_sw_inc(uint32_t mask __unused)
+{
+	return ENOTSUP;
+}
+

diff --git a/bsd/pthread/a135f_pthread_compat.h b/bsd/pthread/a135f_pthread_compat.h
new file mode 100644
index 0000000..5594ca2
--- /dev/null
+++ b/bsd/pthread/a135f_pthread_compat.h
@@ -0,0 +1,25 @@
+/*
+ * Compile the matching libpthread provider with its kext view of BSD headers.
+ * It owns its full ksyn_waitq_element layout; the kernel's opaque counterpart
+ * reserves this layout. All communication with private BSD state uses callbacks.
+ */
+#ifndef A135F_PTHREAD_COMPAT_H
+#define A135F_PTHREAD_COMPAT_H
+#undef BSD_KERNEL_PRIVATE
+#undef XNU_KERNEL_PRIVATE
+#define __PTHREAD_EXPOSE_INTERNALS__ 1
+#define NEEDS_SCHED_CALL_T 1
+
+/* The seven-argument kext API forwards to the eight-argument kernel vm_fault. */
+#define vm_fault vm_fault_external
+
+/* Avoid collisions with the kernel side of the callback interface. */
+#define pthread_kern a135f_pthread_kern
+#define current_uthread a135f_pthread_current_uthread
+#define pthread_start a135f_pthread_start
+#define pthread_stop a135f_pthread_stop
+
+/* os/log passes &__dso_handle as the containing Mach-O image address. */
+extern void *a135f_pthread_log_image __asm("__mh_execute_header");
+#define __dso_handle a135f_pthread_log_image
+#endif
diff --git a/bsd/pthread/a135f_pthread_init.c b/bsd/pthread/a135f_pthread_init.c
new file mode 100644
index 0000000..6ad2474
--- /dev/null
+++ b/bsd/pthread/a135f_pthread_init.c
@@ -0,0 +1,26 @@
+/* Built-in provider: Apple libpthread-514.100.2, paired with xnu-8796.141.3. */
+#if defined(ARM64_BOARD_CONFIG_A135F)
+#include "a135f_pthread_compat.h"
+#include "a135f_libpthread/kern/kern_init.c"
+
+/* Keep the provider's full layout within the kernel's reserved storage. */
+_Static_assert(sizeof(struct ksyn_waitq_element) == 56,
+    "update A135F ksyn storage in sys/pthread_internal.h");
+
+/* Restore the startup interface after compiling the provider's kext code. */
+#define XNU_KERNEL_PRIVATE 1
+#include <kern/startup.h>
+#include <pexpert/pexpert.h>
+
+__startup_func
+static void
+a135f_pthread_register(void)
+{
+    kern_return_t kr = a135f_pthread_start(NULL, NULL);
+    if (kr != KERN_SUCCESS || a135f_pthread_kern == NULL) {
+        panic("A135F: pthread provider registration failed: %d", kr);
+    }
+    kprintf("A135F pthread: libpthread-514.100.2 registered\n");
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_SECOND, a135f_pthread_register);
+#endif /* ARM64_BOARD_CONFIG_A135F */

+		if (prop_size < 4 * sizeof(uint64_t)) {
+			panic("%s: incorrect reg property size in GIC DT node; expecting 32 bytes but got %u bytes", __func__, prop_size);
+		}
+		void const *timer_prop;
+		unsigned int timer_size;
+		if (SecureDTGetProperty(entry, "virtual-timer-intid", &timer_prop, &timer_size) == kSuccess) {
+			if (timer_size != sizeof(uint32_t)) {
+				panic("%s: invalid virtual-timer-intid size %u", __func__, timer_size);
+			}
+			uint32_t intid = *(const uint32_t *)timer_prop;
+			if (intid < 16 || intid >= 32) {
+				panic("%s: virtual timer INTID %u is not a PPI", __func__, intid);
+			}
+			a135f_vtimer_intid = intid;
+		}
+		kprintf("A135F GIC: virtual timer INTID %u\n", a135f_vtimer_intid);
+
+		vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
+		uint64_t const *regs = (uint64_t const *)prop;
+
+		a135f_gicd_base = ml_io_map(soc_base_phys + regs[0], regs[1]);
+		if (!a135f_gicd_base) {
+			panic("%s: cannot map GICD region", __func__);
+		}
+		a135f_gicc_base = ml_io_map(soc_base_phys + regs[2], regs[3]);
+		if (!a135f_gicc_base) {
+			panic("%s: cannot map GICC region", __func__);
+		}
+
+		// Boot CPU: turn the distributor on (the bootloader leaves it as Linux expects to find it).
+		gicd_write32(GICD_CTLR, gicd_read32(GICD_CTLR) | GICD_CTLR_ENABLEGRP1);
+		__builtin_arm_dsb(DSB_SY);
+	}
+
+	// Per-CPU (banked) PPI/SGI state: priority 0xa0 like Linux, enable the
+	// virtual timer PPI and the IPI SGI.
+	for (unsigned int i = 0; i < 32; i += 4) {
+		gicd_write32(GICD_IPRIORITYR0 + i, 0xA0A0A0A0);
+	}
+	gicd_write32(GICD_ISENABLER0, (1U << a135f_vtimer_intid) | (1U << A135F_IPI_SGI));
+
+	// Our CPU interface bit: GICD_ITARGETSR0..7 are read-only and read back
+	// the calling CPU's interface mask in every byte (see Linux gic_get_cpumask()).
+	uint32_t mask = 0;
+	for (unsigned int i = 0; i < 32 && !mask; i += 4) {
+		mask = gicd_read32(GICD_ITARGETSR0 + i);
+		mask |= mask >> 16;
+		mask |= mask >> 8;
+		mask &= 0xff;
+	}
+	unsigned int cpu = ml_get_cpu_number_local();
+	if (cpu < MAX_CPUS) {
+		a135f_gic_cpu_target[cpu] = (uint8_t)mask;
+	}
+
+	// CPU interface: unmask all but the lowest priorities, no preemption grouping, enable Group 1.
+	gicc_write32(GICC_PMR, 0xF0);
+	gicc_write32(GICC_BPR, 0);
+	uint32_t ctlr = gicc_read32(GICC_CTLR) & GICC_CTLR_DIS_BYPASS_MASK; // EOImode 0: EOIR also deactivates
+	gicc_write32(GICC_CTLR, ctlr | GICC_CTLR_ENABLEGRP1);
+	__builtin_arm_dsb(DSB_SY);
+	__builtin_arm_isb(ISB_SY);
 }
 #else

+		if (SecureDTLookupEntry(NULL, "/arm-io/gic", &entry) != kSuccess) {
+			panic("%s: cannot find GIC node in DT", __func__);
+		}
+		if (SecureDTGetProperty(entry, "reg", &prop, &prop_size) != kSuccess) {

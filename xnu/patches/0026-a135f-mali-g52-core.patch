--- /dev/null
+++ b/bsd/dev/a135f_mali.c
@@ -0,0 +1,756 @@
+/*
+ * The Mali-G52 of the Galaxy A13 (Exynos850), brought up from the kernel. Opt-in: boot-arg
+ * a135f_mali=1 (a GPU register read with its power domain or clock off hangs the bus, so nothing
+ * here runs by default).
+ *
+ * Panfrost/Bifrost driver for Mali-G52 (Exynos850)
+ * everything from the GPU's soft reset on is Bifrost's and is the same. Only the way the block
+ * gets power and a clock differs, done here like Linux does it:
+ *
+ *   1  CMU_TOP: the "g3d switch" clock (mux, divider, gate), drivers/clk/samsung/clk-exynos850.c
+ *   2  PMU: the G3D power domain (drivers/soc/samsung/pm_domains.c: PD_G3D at PMU + 0x1d00,
+ *      CONF = 1 to power on, STATUS bit 0 says when it is)
+ *   3  CMU_G3D: mout_g3d_busd -> mout_g3d_switch_user -> dout_g3d_switch, the GPU clock gate and
+ *      the bus gates (only reachable once the power domain is on)
+ *   4  the GPU: which one it is, a soft reset, its L2, tiler and shader cores powered
+ *   5  one job -- write a value into memory -- in identity mode, then
+ *   6  the same job through the GPU's own page tables
+ *
+ * GPU supplies are left as dummy regs here, as i turn them on manually in uniLoader
+ * due to it being reliable and simple to do, and is an easy workaround for no reg control present.
+ * Jobs run to their end before the submit call returns (one address space, one job at a time).
+ *
+ * sysctl kern.a135f_mali says how far it got: 6 means every step worked.
+ * Boot-args: a135f_mali=1, a135f_mali_mux=N (CMU_TOP g3d switch source: 0 shared0/2, 1 shared1/2,
+ * 2 shared0/3, 3 shared1/3), a135f_mali_div=N (switch divider, rate / (N + 1)), a135f_mali_fastmap=0.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ARM64_BOARD_CONFIG_A135F)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <kern/locks.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern kern_return_t thread_terminate(thread_t);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void A135FMaliStart(void);       /* iokit/Kernel/arm/A135FMali.cpp */
+
+void a135f_mali_init(void);
+bool a135f_mali_ready(void);
+bool a135f_mali_parameter(uint32_t which, uint64_t *value);
+uint64_t a135f_mali_address(uint64_t size);
+bool a135f_mali_map(uint64_t gpu, uint64_t phys);
+void a135f_mali_unmap(uint64_t gpu, uint64_t size);
+void a135f_mali_mapped(void);
+uint32_t a135f_mali_submit(uint64_t chain, bool fragment);
+uint64_t a135f_mali_run(uint64_t chain, bool fragment, uint32_t *status);
+void a135f_mali_tag(uint64_t address, uint32_t kind);
+void a135f_mali_flush(uint64_t va, uint64_t len);
+
+#define PMU_PA          0x11860000u
+#define PMU_PD_G3D      0x1d00          /* CONF; STATUS at +4 */
+#define CMU_TOP_PA      0x120e0000u
+#define CMU_G3D_PA      0x11400000u
+#define MALI_PA         0x11500000u
+
+/* CMU_TOP */
+#define TOP_MUX_G3D_SW  0x1038          /* 2 bits */
+#define TOP_DIV_G3D_SW  0x1844          /* 3 bits */
+#define TOP_GAT_G3D_SW  0x2040
+/* CMU_G3D */
+#define G3D_MUX_USER    0x0600          /* bit 4: 1 = dout_g3d_switch */
+#define G3D_MUX_BUSD    0x1000          /* bit 0: 1 = mout_g3d_switch_user */
+#define G3D_GAT_CMU_PCLK 0x2000
+#define G3D_GAT_GPU     0x2004
+#define G3D_GAT_TZPC    0x200c
+#define G3D_GAT_GRAY2BIN 0x2010
+#define G3D_GAT_BUSD    0x2024
+#define G3D_GAT_BUSP    0x2028
+#define G3D_GAT_SYSREG  0x202c
+#define CMU_BUSY        (1u << 16)
+#define CMU_GATE_EN     (1u << 21)
+#define CMU_GATE_MANUAL (1u << 20)
+#define CMU_GATE_HWACG  (1u << 28)
+
+SYSCTL_DECL(_kern);
+static uint32_t reached, gpu_id, shader_mask, mmu_features;
+SYSCTL_UINT(_kern, OID_AUTO, a135f_mali, CTLFLAG_RD | CTLFLAG_LOCKED, &reached, 0,
+    "how far the Mali came up: 6 is a job run through page tables");
+SYSCTL_UINT(_kern, OID_AUTO, a135f_mali_id, CTLFLAG_RD | CTLFLAG_LOCKED, &gpu_id, 0, "GPU_ID");
+
+static vm_offset_t pmu, cmu_top, cmu_g3d, mali;
+
+static inline uint32_t
+rd(vm_offset_t base, uint32_t at)
+{
+	return *(volatile uint32_t *)(base + at);
+}
+
+static inline void
+wr(vm_offset_t base, uint32_t at, uint32_t value)
+{
+	*(volatile uint32_t *)(base + at) = value;
+	__asm__ volatile ("dsb sy");
+}
+
+static bool
+wait_for(vm_offset_t base, uint32_t at, uint32_t mask, uint32_t want, uint32_t ms)
+{
+	for (uint32_t us = 0; us < ms * 1000; us += 10) {
+		if ((rd(base, at) & mask) == want) {
+			return true;
+		}
+		delay(10);
+	}
+	return (rd(base, at) & mask) == want;
+}
+
+/* kernel virtual address -> physical (pmap_find_phys, as the USB driver does) */
+static uint64_t
+va_to_pa(vm_offset_t va)
+{
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)va);
+
+	return ((uint64_t)pn << PAGE_SHIFT) | ((uint64_t)va & PAGE_MASK);
+}
+
+/* clean + invalidate the data cache over a kernel virtual range (flush_dcache64: libkern.h) */
+static void
+flush_va(vm_offset_t va, size_t len)
+{
+	flush_dcache64((addr64_t)va, (unsigned)len, 0);
+}
+
+/* ---- clocks and power ---- */
+
+/* clk-exynos-arm64.c: gates are put in manual mode, then enabled */
+static void
+gate_on(vm_offset_t cmu, uint32_t off)
+{
+	uint32_t v = rd(cmu, off);
+
+	v |= CMU_GATE_MANUAL | CMU_GATE_EN;
+	v &= ~CMU_GATE_HWACG;
+	wr(cmu, off, v);
+}
+
+static void
+mux_set(vm_offset_t cmu, uint32_t off, uint32_t shift, uint32_t mask, uint32_t value)
+{
+	uint32_t v = rd(cmu, off);
+
+	v = (v & ~(mask << shift)) | (value << shift);
+	wr(cmu, off, v);
+	(void)wait_for(cmu, off, CMU_BUSY, 0, 10);
+}
+
+static bool
+clocks_top(void)
+{
+	uint32_t mux = 0, div = 0;
+
+	(void)PE_parse_boot_argn("a135f_mali_mux", &mux, sizeof(mux));
+	(void)PE_parse_boot_argn("a135f_mali_div", &div, sizeof(div));
+	mux_set(cmu_top, TOP_MUX_G3D_SW, 0, 3, mux & 3);
+	mux_set(cmu_top, TOP_DIV_G3D_SW, 0, 7, div & 7);
+	gate_on(cmu_top, TOP_GAT_G3D_SW);
+	printf("a135f mali: CMU_TOP g3d switch: mux %#x div %#x gate %#x\n", rd(cmu_top, TOP_MUX_G3D_SW),
+	    rd(cmu_top, TOP_DIV_G3D_SW), rd(cmu_top, TOP_GAT_G3D_SW));
+	return true;
+}
+
+static bool
+power_domain(void)
+{
+	if ((rd(pmu, PMU_PD_G3D + 4) & 1) != 0) {
+		printf("a135f mali: G3D power domain already on\n");
+		return true;
+	}
+	wr(pmu, PMU_PD_G3D, 1);
+	if (!wait_for(pmu, PMU_PD_G3D + 4, 1, 1, 20)) {
+		printf("a135f mali: G3D power domain did not come up (status %#x)\n", rd(pmu, PMU_PD_G3D + 4));
+		return false;
+	}
+	return true;
+}
+
+static void
+clocks_g3d(void)
+{
+	mux_set(cmu_g3d, G3D_MUX_USER, 4, 1, 1);
+	mux_set(cmu_g3d, G3D_MUX_BUSD, 0, 1, 1);
+	gate_on(cmu_g3d, G3D_GAT_CMU_PCLK);
+	gate_on(cmu_g3d, G3D_GAT_BUSP);
+	gate_on(cmu_g3d, G3D_GAT_SYSREG);
+	gate_on(cmu_g3d, G3D_GAT_TZPC);
+	gate_on(cmu_g3d, G3D_GAT_BUSD);
+	gate_on(cmu_g3d, G3D_GAT_GRAY2BIN);
+	gate_on(cmu_g3d, G3D_GAT_GPU);
+	printf("a135f mali: CMU_G3D user %#x busd %#x gpu gate %#x\n", rd(cmu_g3d, G3D_MUX_USER),
+	    rd(cmu_g3d, G3D_MUX_BUSD), rd(cmu_g3d, G3D_GAT_GPU));
+}
+
+/* ---- the GPU's registers (Linux drivers/gpu/drm/panfrost/panfrost_regs.h) ---- */
+
+#define GPU_ID_REG          0x000
+#define MMU_FEATURES_REG    0x014
+#define GPU_INT_RAWSTAT     0x020
+#define GPU_INT_CLEAR       0x024
+#define GPU_INT_MASK        0x028
+#define GPU_CMD             0x030
+#define SHADER_PRESENT      0x100
+#define TILER_PRESENT       0x110
+#define L2_PRESENT          0x120
+#define SHADER_READY        0x140
+#define TILER_READY         0x150
+#define L2_READY            0x160
+#define SHADER_PWRON        0x180
+#define TILER_PWRON         0x190
+#define L2_PWRON            0x1a0
+#define IRQ_RESET_COMPLETED (1u << 8)
+
+#define JOB_INT_RAWSTAT     0x1000
+#define JOB_INT_CLEAR       0x1004
+#define JOB_INT_MASK        0x1008
+#define JS0                 0x1800
+#define JS1                 0x1880
+#define JS_STATUS           0x24
+#define JS_HEAD_NEXT_LO     0x40
+#define JS_HEAD_NEXT_HI     0x44
+#define JS_AFFINITY_NEXT_LO 0x50
+#define JS_AFFINITY_NEXT_HI 0x54
+#define JS_CONFIG_NEXT      0x58
+#define JS_COMMAND_NEXT     0x60
+#define JS_CONFIG           ((3u << 8) | (3u << 12) | (8u << 16))
+
+#define MMU_INT_RAWSTAT     0x2000
+#define MMU_INT_CLEAR       0x2004
+#define AS0                 0x2400
+#define AS_TRANSTAB_LO      0x00
+#define AS_TRANSTAB_HI      0x04
+#define AS_MEMATTR_LO       0x08
+#define AS_MEMATTR_HI       0x0c
+#define AS_COMMAND          0x18
+#define AS_FAULTSTATUS      0x1c
+#define AS_FAULTADDRESS_LO  0x20
+#define AS_FAULTADDRESS_HI  0x24
+#define AS_STATUS           0x28
+#define AS_TRANSCFG_LO      0x30
+#define AS_TRANSCFG_HI      0x34
+
+/* ---- one job ---- */
+
+static bool
+run_write_job(vm_offset_t page, uint64_t gpu, const char *what)
+{
+	volatile uint32_t *job = (volatile uint32_t *)page, *target = (volatile uint32_t *)(page + 0x800);
+	bool ok;
+
+	bzero((void *)page, PAGE_SIZE);
+	job[4] = (2u << 1) | 1u | (1u << 16);   /* write value; 64-bit pointers; job index 1 */
+	job[8] = (uint32_t)(gpu + 0x800);
+	job[9] = (uint32_t)((gpu + 0x800) >> 32);
+	job[10] = 6;                            /* a 32-bit immediate */
+	job[12] = 0xc0ffee01u;
+	flush_va(page, PAGE_SIZE);
+
+	wr(mali, JOB_INT_MASK, 0);
+	wr(mali, JOB_INT_CLEAR, 0xffffffffu);
+	wr(mali, JS1 + JS_HEAD_NEXT_LO, (uint32_t)gpu);
+	wr(mali, JS1 + JS_HEAD_NEXT_HI, (uint32_t)(gpu >> 32));
+	wr(mali, JS1 + JS_AFFINITY_NEXT_LO, shader_mask);
+	wr(mali, JS1 + JS_AFFINITY_NEXT_HI, 0);
+	wr(mali, JS1 + JS_CONFIG_NEXT, JS_CONFIG);
+	wr(mali, JS1 + JS_COMMAND_NEXT, 1);
+	(void)wait_for(mali, JOB_INT_RAWSTAT, (1u << 1) | (1u << 17), 1u << 1, 100);
+
+	flush_va(page, PAGE_SIZE);
+	ok = *target == 0xc0ffee01u;
+	printf("a135f mali: %s: interrupts %#x, slot status %#x, MMU fault %#x, job status %#x, the word %#x%s\n", what,
+	    rd(mali, JOB_INT_RAWSTAT), rd(mali, JS1 + JS_STATUS), rd(mali, AS0 + AS_FAULTSTATUS), job[0], *target,
+	    ok ? " -- the GPU ran it" : " -- NOT WRITTEN");
+	wr(mali, JOB_INT_CLEAR, 0xffffffffu);
+	return ok;
+}
+
+static void
+as0_update(uint64_t transtab, uint32_t transcfg)
+{
+	wr(mali, AS0 + AS_TRANSTAB_LO, (uint32_t)transtab);
+	wr(mali, AS0 + AS_TRANSTAB_HI, (uint32_t)(transtab >> 32));
+	wr(mali, AS0 + AS_TRANSCFG_LO, transcfg);
+	wr(mali, AS0 + AS_TRANSCFG_HI, 0);
+	wr(mali, AS0 + AS_MEMATTR_LO, 0x88888888u);
+	wr(mali, AS0 + AS_MEMATTR_HI, 0x88888888u);
+	wr(mali, AS0 + AS_COMMAND, 1);          /* update */
+	(void)wait_for(mali, AS0 + AS_STATUS, 1, 0, 50);
+}
+
+/* ---- the GPU's own page tables: AArch64 stage 1, 4 KB pages, 35 address bits, three levels ---- */
+
+#define PTE_TABLE           3ull
+#define PTE_PAGE            3ull
+#define PTE_AF              (1ull << 10)
+#define PTE_SH_INNER        (3ull << 8)
+#define PTE_AP_RW           (1ull << 6)
+#define PTE_ADDRESS         0x0000fffffffff000ull
+#define TRANSCFG_WALK_WB    (6u | (20u << 6) | (2u << 24) | (1u << 30))
+#define TRANSCFG_WALK_NC    (6u | (20u << 6) | (1u << 24))
+static uint32_t mali_fastmap = 1;
+#define TRANSCFG_AARCH64_4K (mali_fastmap ? TRANSCFG_WALK_NC : TRANSCFG_WALK_WB)
+
+static uint64_t *pt_top;
+static uint64_t pt_top_phys;
+
+static uint64_t *
+pt_page(uint64_t *phys)
+{
+	vm_offset_t page = 0;
+
+	if (kmem_alloc(kernel_map, &page, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return NULL;
+	}
+	*phys = va_to_pa(page);
+	flush_va(page, PAGE_SIZE);
+	return (uint64_t *)page;
+}
+
+/*
+ * The tables' own virtual addresses are kept beside them (no phystokv: the entries hold physical
+ * addresses only): the three levels are pt_top (32 entries), pt_mid_table[t] (512) and the bottom
+ * tables, whose pointers sit in pt_mid_shadow[t]->bottom[m].
+ */
+struct pt_shadow {
+	uint64_t *bottom[512];
+};
+static uint64_t *pt_mid_table[32];
+static struct pt_shadow *pt_mid_shadow[32];
+
+static struct pt_shadow *
+pt_shadow_alloc(void)
+{
+	vm_offset_t page = 0;
+
+	if (kmem_alloc(kernel_map, &page, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return NULL;
+	}
+	return (struct pt_shadow *)page;
+}
+
+/* The bottom-level entry for GPU address `gpu`; with `create`, tables are made on the way. mali_lock held. */
+static uint64_t *
+pt_entry(uint64_t gpu, bool create)
+{
+	uint32_t t = (uint32_t)((gpu >> 30) & 31), m = (uint32_t)((gpu >> 21) & 511), b = (uint32_t)((gpu >> 12) & 511);
+	uint64_t phys;
+	uint64_t *table;
+
+	if (pt_top == NULL) {
+		if (!create || (pt_top = pt_page(&pt_top_phys)) == NULL) {
+			return NULL;
+		}
+	}
+	if (pt_mid_table[t] == NULL) {
+		struct pt_shadow *shadow;
+
+		if (!create || (table = pt_page(&phys)) == NULL) {
+			return NULL;
+		}
+		if ((shadow = pt_shadow_alloc()) == NULL) {
+			return NULL;
+		}
+		pt_mid_table[t] = table;
+		pt_mid_shadow[t] = shadow;
+		pt_top[t] = phys | PTE_TABLE;
+		flush_va((vm_offset_t)&pt_top[t], sizeof(pt_top[t]));
+	}
+	if (pt_mid_shadow[t]->bottom[m] == NULL) {
+		if (!create || (table = pt_page(&phys)) == NULL) {
+			return NULL;
+		}
+		pt_mid_shadow[t]->bottom[m] = table;
+		pt_mid_table[t][m] = phys | PTE_TABLE;
+		flush_va((vm_offset_t)&pt_mid_table[t][m], sizeof(pt_mid_table[t][m]));
+	}
+	return &pt_mid_shadow[t]->bottom[m][b];
+}
+
+/* One 4 KB page at GPU address `gpu` (mali_lock held, or before anyone else runs). */
+static bool
+map_page(uint64_t gpu, uint64_t phys)
+{
+	uint64_t *entry = pt_entry(gpu, true);
+
+	if (entry == NULL) {
+		return false;
+	}
+	*entry = (phys & PTE_ADDRESS) | PTE_AF | PTE_SH_INNER | PTE_AP_RW | PTE_PAGE;
+	flush_va((vm_offset_t)entry, sizeof(*entry));
+	return true;
+}
+
+#define FIRST_JOB_GPU       0x00100000ull
+
+static unsigned
+first_jobs(void)
+{
+	vm_offset_t page = 0;
+	unsigned done = 0;
+
+	if (kmem_alloc(kernel_map, &page, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("a135f mali: no page for the first jobs\n");
+		return 0;
+	}
+	as0_update(0, 2);                       /* identity: a GPU address is the physical one */
+	if (run_write_job(page, va_to_pa(page), "first job, identity mode")) {
+		done = 1;
+		if (map_page(FIRST_JOB_GPU, va_to_pa(page))) {
+			as0_update(pt_top_phys, TRANSCFG_AARCH64_4K);
+			if (run_write_job(page, FIRST_JOB_GPU, "second job, through the GPU's page tables")) {
+				done = 2;
+			}
+		} else {
+			printf("a135f mali: no memory for page tables\n");
+		}
+	}
+	kmem_free(kernel_map, page, PAGE_SIZE);
+	return done;
+}
+
+static void
+mali_up(void)
+{
+	uint32_t shaders, tiler, l2;
+
+	pmu = ml_io_map(PMU_PA, 0x2000);
+	cmu_top = ml_io_map(CMU_TOP_PA, 0x8000);
+	cmu_g3d = ml_io_map(CMU_G3D_PA, 0x8000);
+	mali = ml_io_map(MALI_PA, 0x5000);
+	if (!pmu || !cmu_top || !cmu_g3d || !mali) {
+		printf("a135f mali: cannot map registers\n");
+		return;
+	}
+
+	/* 1, 2, 3: clock, power, then the block's own clocks (reachable only with power) */
+	if (!clocks_top()) {
+		return;
+	}
+	reached = 1;
+	if (!power_domain()) {
+		return;
+	}
+	reached = 2;
+	clocks_g3d();
+	reached = 3;
+
+	/* 4: the GPU itself */
+	gpu_id = rd(mali, GPU_ID_REG);
+	mmu_features = rd(mali, MMU_FEATURES_REG);
+	shaders = shader_mask = rd(mali, SHADER_PRESENT);
+	tiler = rd(mali, TILER_PRESENT);
+	l2 = rd(mali, L2_PRESENT);
+	printf("a135f mali: GPU_ID %#x MMU_FEATURES %#x shaders %#x tiler %#x L2 %#x\n", gpu_id, mmu_features, shaders, tiler, l2);
+	if (gpu_id == 0 || gpu_id == 0xffffffffu) {
+		printf("a135f mali: GPU_ID reads %#x: block not alive\n", gpu_id);
+		return;
+	}
+	wr(mali, GPU_INT_MASK, 0);
+	wr(mali, GPU_INT_CLEAR, 0xffffffffu);
+	wr(mali, GPU_CMD, 1);                   /* soft reset */
+	if (!wait_for(mali, GPU_INT_RAWSTAT, IRQ_RESET_COMPLETED, IRQ_RESET_COMPLETED, 100)) {
+		printf("a135f mali: GPU_ID %#x, but it did not finish its reset\n", gpu_id);
+		return;
+	}
+	wr(mali, GPU_INT_CLEAR, 0xffffffffu);
+	wr(mali, L2_PWRON, l2);
+	wr(mali, TILER_PWRON, tiler);
+	wr(mali, SHADER_PWRON, shaders);
+	if (!wait_for(mali, L2_READY, l2, l2, 50) || !wait_for(mali, TILER_READY, tiler, tiler, 50) ||
+	    !wait_for(mali, SHADER_READY, shaders, shaders, 50)) {
+		printf("a135f mali: cores did not all power up (shaders ready %#x)\n", rd(mali, SHADER_READY));
+		return;
+	}
+	reached = 4;
+	printf("a135f mali: GPU_ID %#x (Mali-G52 r%up%u): all powered\n", gpu_id, (gpu_id >> 12) & 0xf, (gpu_id >> 4) & 0xff);
+
+	switch (first_jobs()) {
+	case 2:
+		reached = 6;
+		break;
+	case 1:
+		reached = 5;
+		break;
+	default:
+		break;
+	}
+}
+
+/* ---- what the IOKit service (iokit/Kernel/arm/A135FMali.cpp) uses ---- */
+
+static LCK_GRP_DECLARE(mali_lock_group, "a135f-mali");
+static LCK_MTX_DECLARE(mali_lock, &mali_lock_group);
+static LCK_MTX_DECLARE(mali_job_lock, &mali_lock_group);
+static int mali_wait_event;
+static LCK_MTX_DECLARE(mali_wait_lock, &mali_lock_group);
+
+static bool
+wait_job(uint32_t at, uint32_t mask, uint32_t want, uint32_t ms)
+{
+	uint64_t deadline;
+
+	for (int i = 0; i < 20; i++) {
+		if ((rd(mali, at) & mask) == want) {
+			return true;
+		}
+		delay(10);
+	}
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	while (mach_absolute_time() < deadline) {
+		uint64_t nap;
+
+		if ((rd(mali, at) & mask) == want) {
+			return true;
+		}
+		clock_interval_to_deadline(200, NSEC_PER_USEC, &nap);
+		lck_mtx_lock(&mali_wait_lock);
+		(void)lck_mtx_sleep_deadline(&mali_wait_lock, LCK_SLEEP_DEFAULT, (event_t)&mali_wait_event, THREAD_UNINT, nap);
+		lck_mtx_unlock(&mali_wait_lock);
+	}
+	return (rd(mali, at) & mask) == want;
+}
+
+#define GPU_ADDRESS_FIRST   0x01000000ull
+#define GPU_ADDRESS_END     (1ull << 35)
+static uint64_t next_address = GPU_ADDRESS_FIRST;
+static uint64_t job_seq;
+
+bool
+a135f_mali_ready(void)
+{
+	return reached >= 6;
+}
+
+/* Linux's DRM_PANFROST_PARAM_*, in its order, from the registers they come from. */
+bool
+a135f_mali_parameter(uint32_t which, uint64_t *value)
+{
+	static const uint16_t simple[] = {
+		[5] = 0xe00,
+		[6] = 0x018, [7] = 0x01c, [8] = 0x004, [9] = 0x008, [10] = 0x00c, [11] = 0x010, [12] = 0x014,
+		[13] = 0x0ac, [14] = 0x0a0, [15] = 0x0a4, [16] = 0x0a8, [17] = 0x300,
+		[18] = 0x0b0, [19] = 0x0b4, [20] = 0x0b8, [21] = 0x0bc,
+	};
+
+	if (!a135f_mali_ready()) {
+		return false;
+	}
+	switch (which) {
+	case 0:
+		*value = gpu_id >> 16;
+		return true;
+	case 1:
+		*value = gpu_id & 0xffff;
+		return true;
+	case 2:
+	case 3:
+	case 4:
+		*value = rd(mali, 0x100 + (which - 2) * 0x10) | ((uint64_t)rd(mali, 0x104 + (which - 2) * 0x10) << 32);
+		return true;
+	case 38:                                /* NR_CORE_GROUPS */
+		*value = 1;
+		return true;
+	case 39:                                /* THREAD_TLS_ALLOC: never less than THREAD_MAX_THREADS (MT6768 run 25 Oct) */
+		*value = rd(mali, 0x310);
+		if (*value < rd(mali, 0x0a0)) {
+			*value = rd(mali, 0x0a0);
+		}
+		return true;
+	case 40:                                /* AFBC_FEATURES: none */
+		*value = 0;
+		return true;
+	default:
+		if (which >= 22 && which <= 37) {
+			*value = rd(mali, 0x0c0 + (which - 22) * 4);
+			return true;
+		}
+		if (which < sizeof(simple) / sizeof(simple[0]) && simple[which] != 0) {
+			*value = rd(mali, simple[which]);
+			return true;
+		}
+		return false;
+	}
+}
+
+/* `size` bytes of GPU addresses, never given twice. 0: none left. */
+uint64_t
+a135f_mali_address(uint64_t size)
+{
+	uint64_t address;
+
+	lck_mtx_lock(&mali_lock);
+	address = next_address;
+	if (address + size > GPU_ADDRESS_END) {
+		address = 0;
+	} else {
+		next_address += (size + 0xffff) & ~0xffffull;   /* 64 KB between buffers: an overrun faults */
+	}
+	lck_mtx_unlock(&mali_lock);
+	return address;
+}
+
+/* For the IOKit service: clean + invalidate the CPU's cache over a kernel virtual range. */
+void
+a135f_mali_flush(uint64_t va, uint64_t len)
+{
+	flush_va((vm_offset_t)va, (size_t)len);
+}
+
+void
+a135f_mali_tag(__unused uint64_t address, __unused uint32_t kind)
+{
+}
+
+bool
+a135f_mali_map(uint64_t gpu, uint64_t phys)
+{
+	bool done;
+
+	lck_mtx_lock(&mali_lock);
+	done = map_page(gpu, phys);
+	lck_mtx_unlock(&mali_lock);
+	return done;
+}
+
+void
+a135f_mali_unmap(uint64_t gpu, uint64_t size)
+{
+	lck_mtx_lock(&mali_lock);
+	for (uint64_t at = gpu; at < gpu + size; at += 4096) {
+		uint64_t *entry = pt_entry(at, false);
+
+		if (entry != NULL) {
+			*entry = 0;
+			flush_va((vm_offset_t)entry, sizeof(*entry));
+		}
+	}
+	lck_mtx_unlock(&mali_lock);
+	lck_mtx_lock(&mali_job_lock);           /* an entry taken out: the MMU may hold it */
+	lck_mtx_lock(&mali_lock);
+	as0_update(pt_top_phys, TRANSCFG_AARCH64_4K);
+	lck_mtx_unlock(&mali_lock);
+	lck_mtx_unlock(&mali_job_lock);
+}
+
+/*
+ * After entries were added: with the walks cached (a135f_mali_fastmap=0) the MMU is set up again from the
+ * top -- an UPDATE drops what it cached; a region lock and table flush faulted on the MT6768. With the
+ * default (walks not cached) a new entry needs nothing: an empty entry is one no TLB keeps.
+ */
+void
+a135f_mali_mapped(void)
+{
+	if (mali_fastmap) {
+		return;
+	}
+	lck_mtx_lock(&mali_job_lock);
+	lck_mtx_lock(&mali_lock);
+	as0_update(pt_top_phys, TRANSCFG_AARCH64_4K);
+	lck_mtx_unlock(&mali_lock);
+	lck_mtx_unlock(&mali_job_lock);
+}
+
+/*
+ * One job chain from GPU address `chain`, run to its end before this returns: fragment jobs on
+ * slot 0, the rest on slot 1. 0 when it finished; else the slot's status, a fault, or 0xff for
+ * no answer within a second -- and then the GPU is reset, so the next job finds it working.
+ */
+uint32_t
+a135f_mali_submit(uint64_t chain, bool fragment)
+{
+	uint32_t slot = fragment ? 0 : 1, js = fragment ? JS0 : JS1, raw, status = 0;
+	bool finished;
+
+	lck_mtx_lock(&mali_job_lock);
+	lck_mtx_lock(&mali_lock);
+	wr(mali, JOB_INT_CLEAR, (1u << slot) | (1u << (slot + 16)));
+	wr(mali, js + JS_HEAD_NEXT_LO, (uint32_t)chain);
+	wr(mali, js + JS_HEAD_NEXT_HI, (uint32_t)(chain >> 32));
+	wr(mali, js + JS_AFFINITY_NEXT_LO, shader_mask);
+	wr(mali, js + JS_AFFINITY_NEXT_HI, 0);
+	wr(mali, js + JS_CONFIG_NEXT, JS_CONFIG);
+	wr(mali, js + JS_COMMAND_NEXT, 1);
+	lck_mtx_unlock(&mali_lock);
+	finished = wait_job(JOB_INT_RAWSTAT, (1u << slot) | (1u << (slot + 16)), 1u << slot, 1000);
+	lck_mtx_lock(&mali_lock);
+	if (!finished) {
+		raw = rd(mali, JOB_INT_RAWSTAT);
+		status = (raw & (1u << (slot + 16))) ? rd(mali, js + JS_STATUS) : 0xff;
+		printf("a135f mali: a job on slot %u did not finish: interrupts %#x, status %#x, MMU %#x fault %#x at %#x%08x\n", slot,
+		    raw, rd(mali, js + JS_STATUS), rd(mali, MMU_INT_RAWSTAT), rd(mali, AS0 + AS_FAULTSTATUS),
+		    rd(mali, AS0 + AS_FAULTADDRESS_HI), rd(mali, AS0 + AS_FAULTADDRESS_LO));
+		wr(mali, GPU_INT_CLEAR, 0xffffffffu);
+		wr(mali, GPU_CMD, 1);           /* soft reset, then everything back as it was */
+		(void)wait_for(mali, GPU_INT_RAWSTAT, IRQ_RESET_COMPLETED, IRQ_RESET_COMPLETED, 100);
+		wr(mali, L2_PWRON, rd(mali, L2_PRESENT));
+		wr(mali, TILER_PWRON, rd(mali, TILER_PRESENT));
+		wr(mali, SHADER_PWRON, shader_mask);
+		(void)wait_for(mali, SHADER_READY, shader_mask, shader_mask, 50);
+		as0_update(pt_top_phys, TRANSCFG_AARCH64_4K);
+		wr(mali, MMU_INT_CLEAR, 0xffffffffu);
+	}
+	wr(mali, JOB_INT_CLEAR, (1u << slot) | (1u << (slot + 16)));
+	lck_mtx_unlock(&mali_lock);
+	lck_mtx_unlock(&mali_job_lock);
+	return status;
+}
+
+/* Run a chain to its end; its number comes back, its status in *status. */
+uint64_t
+a135f_mali_run(uint64_t chain, bool fragment, uint32_t *status)
+{
+	uint64_t seq;
+
+	*status = a135f_mali_submit(chain, fragment);
+	lck_mtx_lock(&mali_lock);
+	seq = ++job_seq;
+	lck_mtx_unlock(&mali_lock);
+	return seq;
+}
+
+static void
+mali_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	mali_up();
+	printf("a135f mali: came up to step %u of 6\n", reached);
+	if (reached >= 6) {
+		A135FMaliStart();               /* programs can have it now */
+	}
+	thread_terminate(current_thread());
+}
+
+void
+a135f_mali_init(void)
+{
+	uint32_t on = 0;
+	thread_t thread;
+
+	(void)PE_parse_boot_argn("a135f_mali_fastmap", &mali_fastmap, sizeof(mali_fastmap));
+	if (!PE_parse_boot_argn("a135f_mali", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	if (kernel_thread_start(mali_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_A135F */

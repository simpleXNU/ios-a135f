index 2a645e2..2a1d5f3 100644
--- a/bsd/dev/a135f_usb.c
+++ b/bsd/dev/a135f_usb.c
@@ -1,27 +1,959 @@
 /*
- * USB device mode (CDC-ECM networking + live log) for the Galaxy A13: placeholder.
+ * Galaxy A13 (Exynos850) USB device mode: CDC-ECM networking + live log.
  *
- * The Qualcomm bring-up this replaces (GCC clock gates, QUSB2 PHY, QSCRATCH
- * VBUS override) has no Exynos850 equivalent. What is needed instead:
- *   - clocks: CMU_HSI USB gates (USB_BUS_EARLY_CLK, USB_REF_CLK, USB_PHY_ACLK,
- *     USB_PHY_REF_CLK) - the bootloader may or may not have left them on;
- *   - the Samsung USBDRD UTMI PHY at 0x135d0000 (phy-exynos850-usbdrd) and
- *     its PMU isolation bit in the PMU block at 0x11860000;
- *   - DWC3 at 0x13600000 (size 0x10000), high-speed only (maximum-speed =
- *     "high-speed"), single UTMI PHY, no QSCRATCH.
- * The DWC3 device-mode gadget logic (EP0, ECM, UDP log stream) of the original
- * driver is generic Synopsys DWC3 and can be reused once the PHY is up; the
- * Qualcomm version is kept in docs/reference/qcom-sweet/a135f_usb.c.ref.
+ * Hardware: Synopsys DWC3 (USB 2.0 only, high-speed) at 0x13600000 behind the
+ * Samsung "USBDRD" glue, UTMI PHY at 0x135d0000 (phy-exynos5-usbdrd.c,
+ * exynos850_usbdrd_utmi_init), PHY power isolation in the PMU (0x11860000 +
+ * 0x704), clock gates in CMU_HSI (0x13400000). Nothing guarantees the
+ * bootloader left the PHY running, so this driver
+ *   1. opens the CMU_HSI USB gates (the USER muxes stay as the bootloader set them),
+ *   2. releases the PMU PHY isolation,
+ *   3. runs the UTMI PHY init (26 MHz reference, VBUS-valid forced since no
+ *      Type-C/charger switch driver exists),
+ *   4. only then touches the DWC3 registers (an access to a gated block hangs).
+ * The gadget code below (EP0, CDC-ECM, UDP log stream) is generic DWC3.
+ * boot-arg a135f_usb: 0 off, 1 bring up the PHY and report state, 2 (default) also start the gadget.
  */
 #if defined(ARM64_BOARD_CONFIG_A135F)
 #include <sys/param.h>
 #include <sys/systm.h>

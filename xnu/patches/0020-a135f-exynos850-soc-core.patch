+static inline uint32_t
+gicd_read32(uint32_t off)
+{
+	return *(volatile uint32_t *)(a135f_gicd_base + off);
+}
+
+static inline void
+gicd_write32(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(a135f_gicd_base + off) = v;
+}
+
+static inline uint32_t
+gicc_read32(uint32_t off)
+{
+	return *(volatile uint32_t *)(a135f_gicc_base + off);
+}
+
+static inline void
+gicc_write32(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(a135f_gicc_base + off) = v;
+}

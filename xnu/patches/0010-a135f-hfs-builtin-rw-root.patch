 				if (S_ISREG(attrp->ca_mode) && (attrp->ca_linkcount > 1)) {
-					printf ("hfs: set linkcount=1 on vol=%s cnid=%u old=%u\n", hfsmp->vcbVN, cnid, attrp->ca_linkcount);
+					if (a135f_hfs_link_note()) {
+						printf ("hfs: set linkcount=1 on vol=%s cnid=%u old=%u\n", hfsmp->vcbVN, cnid, attrp->ca_linkcount);

+			bzero(vm, sizeof(*vm));
+			vm->as = as;
+			if ((vm->top = pt_page(&vm->top_phys)) == NULL) {
+				vm = NULL;
+				break;
+			}
+			vm->live = true;
+			vm_table[as] = vm;
+			as_update(as, vm->top_phys, TRANSCFG_AARCH64_4K);
+		}
+	}
+	lck_mtx_unlock(&mali_lock);
+	lck_mtx_unlock(&mali_job_lock);
+	return vm;
+}
+
+void
+a135f_mali_vm_destroy(struct mali_vm *vm)
+{
+	lck_mtx_lock(&mali_job_lock);
+	lck_mtx_lock(&mali_lock);
+	as_update(vm->as, 0, 1);                /* the address space maps nothing any more */
+	vm_table[vm->as] = NULL;
+	vm_free_tables(vm);
+	lck_mtx_unlock(&mali_lock);
+	lck_mtx_unlock(&mali_job_lock);
+}
+
+bool
+a135f_mali_vm_map(struct mali_vm *vm, uint64_t iova, uint64_t phys, bool writable)
+{
+	bool done;
+
+	lck_mtx_lock(&mali_lock);
+	done = map_page_perm(vm, iova, phys, writable);
+	lck_mtx_unlock(&mali_lock);
+	return done;
+}
+
+void
+a135f_mali_vm_mapped(struct mali_vm *vm)
+{
+	vm_resync(vm);
+}
+
+void
+a135f_mali_vm_unmap(struct mali_vm *vm, uint64_t iova, uint64_t size)
+{
+	vm_unmap_common(vm, iova, size);
+}
+
+uint32_t
+a135f_mali_vm_submit(struct mali_vm *vm, uint64_t chain, bool fragment)
+{
+	return submit_on(vm->as, chain, fragment);
+}
+
+/* A GPU information register (offsets under 0x400, the read-only block), for the device-info record. */
+bool
+a135f_mali_info_reg(uint32_t offset, uint32_t *value)
+{
+	if (!a135f_mali_ready() || offset >= 0x400 || (offset & 3) != 0) {
+		return false;
+	}
+	*value = rd(mali, offset);
+	return true;
+}

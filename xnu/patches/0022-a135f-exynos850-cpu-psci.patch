+static volatile uint64_t *
+a135f_slot(unsigned cpu)
+{
+	return (volatile uint64_t *)(a135f_tramp_va + A135F_TRAMP_MBOX) + cpu * 8;
+}
+
+/* Writes stub #cpu (entry = the real 64-bit secondary entry) and clears its mailbox slot; returns the stub's PA. */
+static uint64_t
+a135f_build_trampoline(unsigned cpu, uint64_t entry)
+{
+	if (cpu >= 8) {
+		return 0;
+	}
+	if (!a135f_tramp_va) {
+		a135f_tramp_va = ml_io_map((vm_offset_t)A135F_TRAMP_PA, 0x1000);
+	}
+	if (!a135f_tramp_va) {
+		return 0;
+	}
+	a135f_mbox_va = (volatile uint64_t *)(a135f_tramp_va + A135F_TRAMP_MBOX);
+	volatile uint64_t *slot = a135f_slot(cpu);
+	for (unsigned i = 0; i < 8; i++) {
+		slot[i] = 0;
+	}
+	volatile uint32_t *code = (volatile uint32_t *)(a135f_tramp_va + A135F_TRAMP_STRIDE * cpu);
+	for (unsigned i = 0; i < A135F_TRAMP_WORDS; i++) {
+		code[i] = a135f_tramp_code[i];
+	}
+	volatile uint64_t *lit = (volatile uint64_t *)(a135f_tramp_va + A135F_TRAMP_STRIDE * cpu + A135F_TRAMP_LIT);
+	lit[0] = 0xfa000000ULL + 2000ULL * 4320ULL;     /* bar base: the A13 framebuffer */
+	lit[1] = entry;
+	lit[2] = A135F_TRAMP_PA + A135F_TRAMP_MBOX + 64ULL * cpu;
+	lit[3] = cpu;

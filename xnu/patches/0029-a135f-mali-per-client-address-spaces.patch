+uint64_t
+a135f_mali_faults(void)
+{
+	return gpu_faults;
+}
+
+uint64_t
+a135f_mali_resets(void)
+{
+	return gpu_resets;
+}
+
+/* Device-wide recovery after a fault the client cannot clear itself. Mappings and tables survive. */
+void
+a135f_mali_reset_device(void)
+{
+	lck_mtx_lock(&mali_job_lock);
+	lck_mtx_lock(&mali_lock);
+	device_recover();
+	lck_mtx_unlock(&mali_lock);
+	lck_mtx_unlock(&mali_job_lock);
+}

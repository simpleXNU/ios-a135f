+a135f_md5.o_INCFLAGS = $(A135F_AES_INC)
+a135f_dec32le.o_INCFLAGS = $(A135F_AES_INC)
+a135f_enc32le.o_INCFLAGS = $(A135F_AES_INC)
+corecrypto_md5.o_INCFLAGS = $(A135F_AES_INC)
+a135f_md5.o_CFLAGS_ADD += -mgeneral-regs-only
+a135f_dec32le.o_CFLAGS_ADD += -mgeneral-regs-only
+a135f_enc32le.o_CFLAGS_ADD += -mgeneral-regs-only
+corecrypto_md5.o_CFLAGS_ADD += -mgeneral-regs-only
+# BearSSL SHA-1 behind the legacy SHA1Init/Update/Final API (corecrypto_sha1.c).
+a135f_sha1.o_INCFLAGS = $(A135F_AES_INC)
+a135f_dec32be.o_INCFLAGS = $(A135F_AES_INC)
+a135f_enc32be.o_INCFLAGS = $(A135F_AES_INC)
+corecrypto_sha1.o_INCFLAGS = $(A135F_AES_INC)
+a135f_sha1.o_CFLAGS_ADD += -mgeneral-regs-only
+a135f_dec32be.o_CFLAGS_ADD += -mgeneral-regs-only
+a135f_enc32be.o_CFLAGS_ADD += -mgeneral-regs-only
+corecrypto_sha1.o_CFLAGS_ADD += -mgeneral-regs-only
+# BearSSL SHA-384/512 for SHA384_*/SHA512_* (corecrypto_sha2.c).
+a135f_sha2big.o_INCFLAGS = $(A135F_AES_INC)
+a135f_dec64be.o_INCFLAGS = $(A135F_AES_INC)
+a135f_enc64be.o_INCFLAGS = $(A135F_AES_INC)
+corecrypto_sha2.o_INCFLAGS = $(A135F_AES_INC)
+a135f_sha2big.o_CFLAGS_ADD += -mgeneral-regs-only
+a135f_dec64be.o_CFLAGS_ADD += -mgeneral-regs-only
+a135f_enc64be.o_CFLAGS_ADD += -mgeneral-regs-only
+corecrypto_sha2.o_CFLAGS_ADD += -mgeneral-regs-only
+endif

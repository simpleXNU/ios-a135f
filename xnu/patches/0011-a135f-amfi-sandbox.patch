diff --git a/bsd/kern/a135f_amfi.c b/bsd/kern/a135f_amfi.c
new file mode 100644
index 0000000..83187b9
--- /dev/null
+++ b/bsd/kern/a135f_amfi.c
@@ -0,0 +1,383 @@
+/*
+ * Built-in AMFI interface for A135F.
+ *
+ * On Apple platforms AppleMobileFileIntegrity registers this interface and
+ * provides entitlements through the closed CoreEntitlements library. A135F
+ * has neither, and code signing reaches it on every exec (ubc_cs_blob_add).
+ *
+ * Entitlements: when a code signature is added, its XML entitlements blob
+ * (already checked against the code directory) is parsed into a
+ * A135FEntitlements object (iokit/Kernel/arm/A135FEntitlements.cpp), set as
+ * the blob's csb_entitlements, and every query is answered from it. DER-only
+ * signatures get none. Code signature and page hash validation stay with the
+ * kernel. Trust caches remain unavailable (no Image4), so the TrustCache
+ * interface is left at version 0.
+ *
+ * Platform binaries: AMFI marks binaries whose cdhash is in a trust cache
+ * as platform binaries from its vnode_check_signature MAC hook. Without
+ * trust caches, the A135F policy below marks every binary on the root
+ * filesystem instead (the iOS system binaries are ad-hoc signed and are
+ * platform binaries only through the static trust cache).
+ *
+ * Interfaces no kernel path uses on A135F (they serve other Apple kexts)
+ * panic with a clear message instead of being NULL.
+ */
+#if defined(ARM64_BOARD_CONFIG_A135F)
+#include <kern/debug.h>
+#include <kern/startup.h>
+#include <libkern/amfi/amfi.h>
+#include <mach/kern_return.h>
+#include <sys/codesign.h>
+#include <sys/mount.h>
+#include <sys/priv.h>
+#include <sys/proc.h>
+#include <sys/systm.h>
+#include <sys/ubc_internal.h>
+#include <sys/vnode.h>
+#include <security/mac_policy.h>
+
+/* iokit/Kernel/arm/A135FEntitlements.cpp */
+void *a135f_entitlements_create(const CS_GenericBlob *blob, size_t blob_len);
+void *a135f_entitlements_copy_dict(const void *ent);
+bool a135f_entitlements_copy_xml(const void *ent, CS_GenericBlob **out);
+bool a135f_entitlements_bool(const void *ent, const char *name);
+bool a135f_entitlements_string(const void *ent, const char *name, const char *value);
+void *a135f_entitlements_copy_object(const void *ent, const char *name);
+unsigned int a135f_entitlements_count(const void *ent);
+extern void osobject_release(void *object);
+
+/* boot-arg a135f_amfi_debug=1: log the entitlements attached to each signature. */
+static TUNABLE(uint32_t, a135f_amfi_debug, "a135f_amfi_debug", 0);
+
+/* The entitlements object of a process's main binary, or NULL. */
+static void *
+a135f_proc_entitlements(proc_t proc)
+{
+	struct cs_blob *blob = csproc_get_blob(proc);
+	return blob != NULL ? csblob_os_entitlements_get(blob) : NULL;
+}
+
+static void
+a135f_amfi_entitlements_invalidate(__unused void *os_entitlements)
+{
+	/* Queries already require a valid signature (csblob_get_entitlements). */
+}
+
+static void *
+a135f_amfi_entitlements_as_dict(void *os_entitlements)
+{
+	return a135f_entitlements_copy_dict(os_entitlements);
+}
+
+static CEError_t
+a135f_amfi_entitlements_query(__unused void *os_entitlements,
+    __unused uint8_t cdhash[CS_CDHASH_LEN], __unused CEQuery_t query,
+    __unused size_t query_length)
+{
+	panic("A135F AMFI: CoreEntitlements queries are not implemented");
+}
+
+static bool
+a135f_amfi_entitlements_get_transmuted(__unused void *os_entitlements,
+    __unused const CS_GenericBlob **blob)
+{
+	return false;
+}
+
+static bool
+a135f_amfi_entitlements_get_xml(void *os_entitlements, CS_GenericBlob **blob)
+{
+	return a135f_entitlements_copy_xml(os_entitlements, blob);
+}
+
+static bool
+a135f_amfi_get_legacy_profile_exemptions(__unused const uint8_t **profile,
+    __unused size_t *profile_length)
+{
+	return false;
+}
+
+static bool
+a135f_amfi_get_udid(__unused const uint8_t **udid, __unused size_t *udid_length)
+{
+	return false;
+}
+
+static void *
+a135f_amfi_query_context_to_object(__unused CEQueryContext_t ctx)
+{
+	panic("A135F AMFI: CoreEntitlements query contexts are not implemented");
+}
+
+static kern_return_t
+a135f_amfi_adjust_with_monitor(__unused void *os_entitlements,
+    __unused const CEQueryContext_t ce_ctx, __unused const void *monitor_sig_obj,
+    __unused const char *identity, __unused const uint32_t code_signing_flags)
+{
+	/* A135F has no code signing monitor. */
+	return KERN_NOT_SUPPORTED;
+}
+
+/*
+ * Attach the parsed XML entitlements to a code signature being added. This
+ * must happen in the vnode_check_signature MAC hook, like AMFI does: later,
+ * converting a 4K-page signature to multilevel hashes drops the XML blob.
+ * Nothing is granted when the blob is missing, unreadable or does not match
+ * its code directory hash.
+ */
+static void
+a135f_amfi_attach_entitlements(struct cs_blob *code_signing_blob)
+{
+	void *xml = NULL;
+	size_t xml_len = 0;
+
+	if (csblob_get_entitlements(code_signing_blob, &xml, &xml_len) != 0) {
+		printf("A135F AMFI: %s: entitlements do not match the code directory, granting none\n",
+		    csblob_get_identity(code_signing_blob));
+		return;
+	}
+	if (xml == NULL) {
+		return;                 /* no XML entitlements */
+	}
+	void *ent = a135f_entitlements_create(xml, xml_len);
+	if (ent == NULL) {
+		printf("A135F AMFI: %s: unreadable entitlements (%zu bytes), granting none\n",
+		    csblob_get_identity(code_signing_blob), xml_len);
+		return;
+	}
+	if (a135f_amfi_debug) {
+		/* The test keys only exist in tools/mkinit.py test signatures. */
+		printf("A135F AMFI: %s: %u entitlements (test: bool %d string %d array %d)\n",
+		    csblob_get_identity(code_signing_blob), a135f_entitlements_count(ent),
+		    a135f_entitlements_bool(ent, "com.apple.private.a135f.test-bool"),
+		    a135f_entitlements_string(ent, "com.apple.private.a135f.test-string", "hello"),
+		    a135f_entitlements_string(ent, "com.apple.private.a135f.test-array", "two"));
+	}
+	csblob_os_entitlements_set(code_signing_blob, ent);    /* takes a reference */
+	osobject_release(ent);
+}
+
+static kern_return_t
+a135f_amfi_adjust_without_monitor(__unused void *os_entitlements,
+    __unused struct cs_blob *code_signing_blob)
+{
+	/* Entitlements were attached in a135f_amfi_vnode_check_signature. */
+	return KERN_SUCCESS;
+}
+
+static kern_return_t
+a135f_amfi_query_boolean(const void *os_entitlements, const char *entitlement_name)
+{
+	return a135f_entitlements_bool(os_entitlements, entitlement_name) ? KERN_SUCCESS : KERN_DENIED;
+}
+
+static kern_return_t
+a135f_amfi_query_boolean_with_proc(const proc_t proc, const char *entitlement_name)
+{
+	return a135f_amfi_query_boolean(a135f_proc_entitlements(proc), entitlement_name);
+}
+
+static kern_return_t
+a135f_amfi_query_string(const void *os_entitlements,
+    const char *entitlement_name, const char *entitlement_value)
+{
+	return a135f_entitlements_string(os_entitlements, entitlement_name, entitlement_value) ?
+	       KERN_SUCCESS : KERN_DENIED;
+}
+
+static kern_return_t
+a135f_amfi_query_string_with_proc(const proc_t proc,
+    const char *entitlement_name, const char *entitlement_value)
+{
+	return a135f_amfi_query_string(a135f_proc_entitlements(proc), entitlement_name,
+	           entitlement_value);
+}
+
+static kern_return_t
+a135f_amfi_copy_object(const void *os_entitlements,
+    const char *entitlement_name, void **entitlement_object)
+{
+	void *obj = a135f_entitlements_copy_object(os_entitlements, entitlement_name);
+	if (entitlement_object) {
+		*entitlement_object = obj;
+	} else if (obj) {
+		osobject_release(obj);
+	}
+	return obj ? KERN_SUCCESS : KERN_NOT_FOUND;
+}
+
+static kern_return_t
+a135f_amfi_copy_object_with_proc(const proc_t proc,
+    const char *entitlement_name, void **entitlement_object)
+{
+	return a135f_amfi_copy_object(a135f_proc_entitlements(proc), entitlement_name,
+	           entitlement_object);
+}
+
+static const amfi_t a135f_amfi = {
+	.OSEntitlements_invalidate = a135f_amfi_entitlements_invalidate,
+	.OSEntitlements_asdict = a135f_amfi_entitlements_as_dict,
+	.OSEntitlements_query = a135f_amfi_entitlements_query,
+	.OSEntitlements_get_transmuted = a135f_amfi_entitlements_get_transmuted,
+	.OSEntitlements_get_xml = a135f_amfi_entitlements_get_xml,
+	/* CoreEntitlements is only used by the PMAP_CS code signing monitor. */
+	.get_legacy_profile_exemptions = a135f_amfi_get_legacy_profile_exemptions,
+	.get_udid = a135f_amfi_get_udid,
+	.query_context_to_object = a135f_amfi_query_context_to_object,
+	/* .TrustCache stays version 0: trust caches are unavailable without Image4. */
+	.OSEntitlements = {
+		.version = OSENTITLEMENTS_INTERFACE_VERSION,
+		.adjustContextWithMonitor = a135f_amfi_adjust_with_monitor,
+		.adjustContextWithoutMonitor = a135f_amfi_adjust_without_monitor,
+		.queryEntitlementBoolean = a135f_amfi_query_boolean,
+		.queryEntitlementBooleanWithProc = a135f_amfi_query_boolean_with_proc,
+		.queryEntitlementString = a135f_amfi_query_string,
+		.queryEntitlementStringWithProc = a135f_amfi_query_string_with_proc,
+		.copyEntitlementAsOSObject = a135f_amfi_copy_object,
+		.copyEntitlementAsOSObjectWithProc = a135f_amfi_copy_object_with_proc,
+	},
+};
+
+__startup_func
+static void
+a135f_amfi_register(void)
+{
+	amfi_interface_register(&a135f_amfi);
+	printf("A135F AMFI: built-in interface registered (XML entitlements)\n");
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_MIDDLE, a135f_amfi_register);
+
+/*
+ * The signature reached this hook validated, so mark it CS_SIGNED like AMFI
+ * does: exec copies the flag to the process, and csproc_get_blob() (csops
+ * status, cdhash, platform and entitlement queries by process) ignores
+ * processes without it. Every signed binary on the root filesystem is a
+ * platform binary. New signatures (ubc_cs_blob_add passes its writable copy;
+ * revalidation passes the read-only blob itself) get their entitlements here.
+ */
+static int
+a135f_amfi_vnode_check_signature(struct vnode *vp, __unused struct label *label,
+    __unused cpu_type_t cpu_type, struct cs_blob *cs_blob,
+    unsigned int *cs_flags, __unused unsigned int *signer_type,
+    __unused int flags, __unused unsigned int platform,
+    __unused char **fatal_failure_desc, __unused size_t *fatal_failure_desc_len)
+{
+	mount_t mp = vnode_mount(vp);
+	*cs_flags |= CS_SIGNED;
+	if (mp != NULL && (vfs_flags(mp) & MNT_ROOTFS)) {
+		*cs_flags |= CS_PLATFORM_BINARY;
+	}
+	if (cs_blob != cs_blob->csb_ro_addr && cs_blob->csb_entitlements == NULL) {
+		a135f_amfi_attach_entitlements(cs_blob);
+	}
+	return 0;
+}
+
+/*
+ * Policy "Sandbox": libsystem_sandbox calls __mac_syscall("Sandbox", op,
+ * arg). Without a policy of that name every call fails with ENOPOLICY and
+ * launchd reports mach lookups as "error = 159: Sandbox restriction"
+ * (backboardd cannot reach mobilegestalt or iohideventsystem; tccd:
+ * "profile not found"). A135F runs without a sandbox: operations succeed
+ * (checks allow, profile init is accepted); the few that must return
+ * data (container paths, extension tokens) fail with ENOENT. The first
+ * use of each operation number is logged.
+ */
+static uint64_t a135f_sandbox_seen;
+
+static int
+a135f_sandbox_syscall(struct proc *p, int call, __unused user_addr_t arg)
+{
+	if (call >= 0 && call < 64 && !(a135f_sandbox_seen & (1ULL << call))) {
+		a135f_sandbox_seen |= 1ULL << call;
+		char name[32];
+		proc_name(proc_pid(p), name, sizeof(name));
+		printf("A135F Sandbox: %s op %d\n", name, call);
+	}
+	switch (call) {
+	case 4:         /* container path (audit token / pid) */
+	case 5:         /* extension issue */
+	case 6:         /* extension consume */
+	case 0x43:      /* container expected */
+		return ENOENT;
+	default:
+		return 0;
+	}
+}
+
+static const struct mac_policy_ops a135f_amfi_mac_ops = {
+	.mpo_vnode_check_signature = a135f_amfi_vnode_check_signature,
+};
+
+/*
+ * Privileges for non-root processes come from MAC policies (priv_check_cred
+ * -> mac_priv_grant); on iOS Sandbox/AMFI grant them. Without a grant UIKit
+ * apps die in CoreAnimation setup: work_interval_create(CA_CLIENT) needs
+ * PRIV_WORK_INTERVAL ("Failed to create work interval", SpringBoard).
+ * Grant that one; log the first denial of each other privilege per process.
+ */
+#define A135F_PRIV_LOG_MAX      64
+static struct {
+	int  priv;
+	char name[20];
+} a135f_priv_logged[A135F_PRIV_LOG_MAX];
+static int a135f_priv_logged_count;
+
+static int
+a135f_sandbox_priv_grant(kauth_cred_t cred __unused, int priv)
+{
+	if (priv == PRIV_WORK_INTERVAL) {
+		return 0;
+	}
+	char name[20];
+	proc_selfname(name, sizeof(name));
+	for (int i = 0; i < a135f_priv_logged_count; i++) {
+		if (a135f_priv_logged[i].priv == priv &&
+		    strncmp(a135f_priv_logged[i].name, name, sizeof(name)) == 0) {
+			return EPERM;
+		}
+	}
+	if (a135f_priv_logged_count < A135F_PRIV_LOG_MAX) {
+		a135f_priv_logged[a135f_priv_logged_count].priv = priv;
+		strlcpy(a135f_priv_logged[a135f_priv_logged_count].name, name, sizeof(name));
+		a135f_priv_logged_count++;
+		printf("A135F Sandbox: %s privilege %d denied\n", name, priv);
+	}
+	return EPERM;
+}
+
+static const struct mac_policy_ops a135f_sandbox_mac_ops = {
+	.mpo_policy_syscall = a135f_sandbox_syscall,
+	.mpo_priv_grant = a135f_sandbox_priv_grant,
+};
+
+static struct mac_policy_conf a135f_sandbox_mac_conf = {
+	.mpc_name = "Sandbox",
+	.mpc_fullname = "A135F permissive sandbox stand-in",
+	.mpc_ops = &a135f_sandbox_mac_ops,
+};
+
+static mac_policy_handle_t a135f_sandbox_mac_handle;
+
+static struct mac_policy_conf a135f_amfi_mac_conf = {
+	.mpc_name = "A135F AMFI",
+	.mpc_fullname = "A135F built-in Mobile File Integrity",
+	.mpc_ops = &a135f_amfi_mac_ops,
+};
+
+static mac_policy_handle_t a135f_amfi_mac_handle;
+
+/* Called from bsd_init once MAC policies can register, before any exec. */
+void a135f_amfi_policy_register(void);
+
+void
+a135f_amfi_policy_register(void)
+{
+	int error = mac_policy_register(&a135f_amfi_mac_conf, &a135f_amfi_mac_handle, NULL);
+	printf("A135F AMFI: platform binary policy %s (%d)\n",
+	    error ? "NOT registered" : "registered", error);
+	error = mac_policy_register(&a135f_sandbox_mac_conf, &a135f_sandbox_mac_handle, NULL);
+	printf("A135F Sandbox: permissive policy %s (%d)\n",
+	    error ? "NOT registered" : "registered", error);
+}
+#endif /* ARM64_BOARD_CONFIG_A135F */

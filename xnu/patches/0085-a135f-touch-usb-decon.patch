+
+/*
+ * The A13 panel only shows the framebuffer once DECON's HW/SW trigger control
+ * (DECON_F 0x13060000 + 0x70) is written with 0x1281. The boot shim does it
+ * first; this repeats it from the kernel (boot-arg a135f_decon_kick=0 skips it).
+ */
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+void
+a135f_decon_kick(void)
+{
+	vm_offset_t decon = ml_io_map(0x13060000u, 0x1000);
+	if (decon) {
+		*(volatile uint32_t *)(decon + 0x70) = 0x1281;
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+}
 #endif /* A135F */

+SECURITY_READ_ONLY_LATE(vm_offset_t) a135f_gicc_base;
+/* GIC CPU interface bit (GICD_SGIR CPUTargetList) of each logical CPU, learned by that CPU. */
+volatile uint8_t a135f_gic_cpu_target[MAX_CPUS];
+
+static inline uint32_t
+gicd_read32(uint32_t off)
+{
+	return *(volatile uint32_t *)(a135f_gicd_base + off);

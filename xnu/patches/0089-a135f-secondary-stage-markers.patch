diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
index f2f3170..f28399b 100644
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -676,6 +676,12 @@ void
 arm_init_cpu(
 	cpu_data_t      *cpu_data_ptr)
 {
+#if defined(A135F)
+	extern volatile uint64_t *a135f_mbox_va;
+	if (a135f_mbox_va && cpu_data_ptr->cpu_number < 8) {
+		a135f_mbox_va[cpu_data_ptr->cpu_number * 4 + 3] = 0x60;        /* MMU on, running C */
+	}
+#endif
 #if __ARM_PAN_AVAILABLE__
 	__builtin_arm_wsr("pan", 1);
 #endif
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index b1cda04..cb4ca7c 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -42,6 +42,29 @@
 
 
 
+#if defined(A135F)
+/*
+ * Secondary-core progress marker for bring-up: MMU is off when this runs, so it stores a stage code
+ * straight to the physical mailbox (0xc8200400 + 32 * cpu + 24) that A135FCPU.cpp reads back if the core
+ * never reports in. Clobbers x9-x11 only.
+ */
+.macro A135F_STAGE
+	mrs		x9, MPIDR_EL1
+	and		x10, x9, #0xff
+	ubfx	x11, x9, #8, #1
+	add		x10, x10, x11, lsl #2
+	lsl		x10, x10, #5
+	MOV64	x11, 0xc8200418
+	add		x10, x10, x11
+	mov		x11, #$0
+	str		x11, [x10]
+	dsb		sy
+.endmacro
+#else
+.macro A135F_STAGE
+.endmacro
+#endif
+
 .macro MSR_VBAR_EL1_X0
 #if defined(KERNEL_INTEGRITY_KTRR)
 	mov	x1, lr
@@ -139,6 +162,7 @@ LEXT(reset_vector)
 
 
 
+	A135F_STAGE 0x53
 	// Process reset handlers
 	adrp	x19, EXT(ResetHandlerData)@page			// Get address of the reset handler data
 	add		x19, x19, EXT(ResetHandlerData)@pageoff
@@ -191,8 +215,10 @@ Lfound_cpu_data_entry:
 	msr		TPIDR_EL1, x13
 #endif /* __ARM_KERNEL_PROTECT__ */
 
+	A135F_STAGE 0x54
 	blr		x0
 Lskip_cpu_reset_handler:
+	A135F_STAGE 0x5f
 	b		.									// Hang if the handler is NULL or returns
 
 	.align 3
@@ -289,6 +315,7 @@ LEXT(bootstrap_instructions)
 	.globl EXT(a135f_secondary_entry)
 LEXT(a135f_secondary_entry)
 	msr		DAIFSet, #0xf
+	A135F_STAGE 0x51
 	mrs		x1, CurrentEL
 	cmp		x1, #0x4
 	b.eq	La135f_secondary_el1
@@ -320,6 +347,7 @@ LEXT(a135f_secondary_entry)
 La135f_secondary_bad_el:
 	b		.
 La135f_secondary_el1:
+	A135F_STAGE 0x52
 	/* x0 is deliberately unused; reset_vector selects CPU data by MPIDR. */
 	msr		SPSel, #1
 	b		EXT(LowResetVectorBase)
@@ -341,6 +369,7 @@ LEXT(start_cpu)
 
 	.align 2
 start_cpu:
+	A135F_STAGE 0x56
 #if defined(KERNEL_INTEGRITY_KTRR) || defined(KERNEL_INTEGRITY_CTRR)
 	// This is done right away in reset vector for pre-KTRR devices
 	// Set low reset vector now that we are in the KTRR-free zone
@@ -829,6 +858,11 @@ common_start:
 	PAC_INIT_KEY_STATE tmp=x0, tmp2=x1
 #endif /* HAS_APPLE_PAC */
 
+#if defined(A135F)
+	cbz		x21, 1f
+	A135F_STAGE 0x57
+1:
+#endif
 	// Enable caches, MMU, ROP and JOP

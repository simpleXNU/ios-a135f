diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index 155647b..bc3218e 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -1205,6 +1205,47 @@ ml_get_boot_cluster_type(void)
 	return topology_info.boot_cluster->cluster_type;
 }
 
+#if defined(A135F)
+/*
+ * A13: the cores' real MPIDRs (0x81000n00: core number in Aff1) differ from the device-tree/PSCI ids
+ * kept in topology_info (which is read-only after machine_lockdown()). A135FCPU::startCPU learns each
+ * core's real MPIDR from its trampoline and records it in this writable table before releasing the
+ * core; ml_get_cpu_number() consults it first. Compared on Aff2:Aff1:Aff0.
+ */
+static volatile uint32_t a135f_real_mpidr[MAX_CPUS];
+static volatile uint8_t a135f_real_valid[MAX_CPUS];
+
+void a135f_set_cpu_mpidr(int cpu, uint32_t id);
+void
+a135f_set_cpu_mpidr(int cpu, uint32_t id)
+{
+	assert(cpu >= 0 && (unsigned)cpu < MAX_CPUS);
+	a135f_real_mpidr[cpu] = id;
+	__builtin_arm_dmb(DMB_ISH);
+	a135f_real_valid[cpu] = 1;
+	__builtin_arm_dsb(DSB_ISH);
+}
+
+int
+ml_get_cpu_number(uint32_t phys_id)
+{
+	phys_id &= MPIDR_AFF2_MASK | MPIDR_AFF1_MASK | MPIDR_AFF0_MASK;
+
+	for (unsigned i = 0; i < topology_info.num_cpus; i++) {
+		if (a135f_real_valid[i] && a135f_real_mpidr[i] == phys_id) {
+			return i;
+		}
+	}
+	/* cores not yet learned (and the boot CPU) are known by their device-tree id */
+	for (unsigned i = 0; i < topology_info.num_cpus; i++) {
+		if (!a135f_real_valid[i] && topology_info.cpus[i].phys_id == phys_id) {
+			return i;
+		}
+	}
+
+	return -1;
+}
+#else
 int
 ml_get_cpu_number(uint32_t phys_id)
 {
@@ -1218,6 +1259,7 @@ ml_get_cpu_number(uint32_t phys_id)
 
 	return -1;
 }
+#endif
 
 int
 ml_get_cluster_number(uint32_t phys_id)

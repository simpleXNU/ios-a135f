 static A135FCPU *a135f_cpus[MAX_CPUS];
 static uint32_t a135f_cpus_registered;
 
+/*
+ * The Samsung EL3 firmware may keep the PSCI entry point in a 32-bit field, while this kernel's
+ * secondary entry lives in RAM above 4 GiB. A small trampoline in free low RAM (never used by xnu)
+ * is therefore the PSCI entry; it draws a yellow bar on the framebuffer, one row block per CPU
+ * (y = 2000 + 12 * cpu), proving the core ran, and then branches to the real 64-bit entry.
+ * boot-arg a135f_tramp=0 passes the kernel entry to PSCI directly.
+ */
+#define A135F_TRAMP_PA 0xc8200000ULL
+extern "C" vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+static const uint32_t a135f_tramp_code[18] = {
+	0x58000242, 0xd2995005, 0x9b050802, 0x529fe003, 0x72bfffe3, 0xd2821c08, 0x52800106, 0xaa0203e7,
+	0x52804004, 0xb80044e3, 0x71000484, 0x54ffffc1, 0x8b080042, 0x710004c6, 0x54ffff21, 0xd5033f9f,
+	0x58000081, 0xd61f0020,
+};
+
+static uint64_t
+a135f_build_trampoline(uint64_t entry)
+{
+	static vm_offset_t va;
+	if (!va) {
+		va = ml_io_map((vm_offset_t)A135F_TRAMP_PA, 0x1000);
+	}
+	if (!va) {
+		return 0;
+	}
+	volatile uint32_t *code = (volatile uint32_t *)va;
+	for (unsigned i = 0; i < 18; i++) {
+		code[i] = a135f_tramp_code[i];
+	}
+	volatile uint64_t *lit = (volatile uint64_t *)(va + 72);
+	lit[0] = 0xfa000000ULL + 2000ULL * 4320ULL;     /* marker base: the A13 framebuffer */
+	lit[1] = entry;
+	__builtin_arm_dsb(DSB_SY);
+	return A135F_TRAMP_PA;
+}
+

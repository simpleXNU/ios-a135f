index 0000000..f0bcf4d
--- /dev/null
+++ b/osfmk/arm64/amcc_rorgn_common.c
@@ -0,0 +1,9 @@
+/*
+ * a135f: files.arm64 builds this for nos_arm_asm, but the source only ships
+ * in Apple's closed per-SoC library. It implements the AMCC read-only region
+ * (KTRR/CTRR kernel text lockdown), which needs Apple memory controller
+ * hardware; nothing references it on A135F (no KERNEL_INTEGRITY_KTRR/CTRR).
+ */
+#include <stdint.h>
+
+static const uint8_t a135f_no_amcc_rorgn __attribute__((unused)) = 0;

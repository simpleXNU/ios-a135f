diff --git a/osfmk/arm64/a135f_early.c b/osfmk/arm64/a135f_early.c
new file mode 100644
index 0000000..e8da4d0
--- /dev/null
+++ b/osfmk/arm64/a135f_early.c
@@ -0,0 +1,143 @@
+/*
+ * Samsung Galaxy A13 (SM-A135F) bootstrap console. No allocation, locks, ADT parsing or
+ * per-CPU state: panic() can reach this before a current thread exists.
+ * start.s maps the splash framebuffer VA=PA as Normal Non-Cacheable memory.
+ * arm_vm_init installs a reserved kernel VA alias before removing TTBR0;
+ * retain this console until the normal framebuffer serial console is ready.
+ */
+#include <arm64/a135f_early.h>
+
+#if defined(A135F)
+#include <stdint.h>
+#include <kern/misc_protos.h>
+
+static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
+#define EARLY_FB early_fb
+#define EARLY_WIDTH 1080u
+#define EARLY_HEIGHT 2400u
+#define EARLY_STRIDE (4320u / 4)
+#define EARLY_SCALE 2u
+#define EARLY_CELL_W (8u * EARLY_SCALE)
+#define EARLY_CELL_H (16u * EARLY_SCALE)
+#define EARLY_ROWS ((EARLY_HEIGHT - 32u) / EARLY_CELL_H)
+#define EARLY_COLS (EARLY_WIDTH / EARLY_CELL_W)
+
+extern unsigned char iso_font[256 * 16];
+
+/* Initialized data must remain writable until disable, including panics. */
+static unsigned int early_row, early_col;
+static unsigned int early_started, early_disabled, early_panicking;
+
+static void
+a135f_early_clear_row(void)
+{
+	for (unsigned int y = 0; y < EARLY_CELL_H; y++) {
+		volatile uint32_t *line = EARLY_FB + (early_row * EARLY_CELL_H + y) * EARLY_STRIDE;
+		for (unsigned int x = 0; x < EARLY_WIDTH; x++) {
+			line[x] = 0xff000000u;
+		}
+	}
+}
+
+void
+a135f_early_putc(char c)
+{
+	if (early_disabled) {
+		return;
+	}
+	if (!early_started) {
+		early_started = 1;
+		a135f_early_clear_row();
+	}
+	if (c == '\r') {
+		early_col = 0;
+		return;
+	}
+	if (c == '\n' || early_col == EARLY_COLS) {
+		early_col = 0;
+		early_row = (early_row + 1) % EARLY_ROWS;
+		a135f_early_clear_row();
+		if (c == '\n') {
+			return;
+		}
+	}
+	const unsigned char *glyph = iso_font + (unsigned char)c * 16;
+	for (unsigned int gy = 0; gy < 16; gy++) {
+		for (unsigned int sy = 0; sy < EARLY_SCALE; sy++) {
+			volatile uint32_t *line = EARLY_FB +
+			    (early_row * EARLY_CELL_H + gy * EARLY_SCALE + sy) * EARLY_STRIDE +
+			    early_col * EARLY_CELL_W;
+			for (unsigned int gx = 0; gx < 8; gx++) {
+				uint32_t pixel = (glyph[gy] & (1u << gx)) ? 0xffffffffu : 0xff000000u;
+				for (unsigned int sx = 0; sx < EARLY_SCALE; sx++) {
+					line[gx * EARLY_SCALE + sx] = pixel;
+				}
+			}
+		}
+	}
+	early_col++;
+}
+
+static void
+a135f_early_string(const char *s)
+{
+	while (*s) {
+		a135f_early_putc(*s++);
+	}
+}
+
+void
+a135f_early_mark(unsigned int stage, const char *label)
+{
+	if (early_disabled || stage > 20) {
+		return;
+	}
+	uint32_t color = 0xff00ff00u | ((stage & 7u) * 32u << 16);
+	for (unsigned int y = EARLY_HEIGHT - 32; y < EARLY_HEIGHT; y++) {
+		for (unsigned int x = stage * 48; x < (stage + 1) * 48; x++) {
+			EARLY_FB[y * EARLY_STRIDE + x] = color;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	a135f_early_string("A135F EARLY ");
+	if (stage >= 10) {
+		a135f_early_putc((char)('0' + stage / 10));
+	}
+	a135f_early_putc((char)('0' + stage % 10));
+	a135f_early_string(": ");
+	a135f_early_string(label);
+	a135f_early_putc('\n');
+}
+
+void
+a135f_early_panic(const char *fmt, va_list *args)
+{
+	if (early_disabled || early_panicking) {
+		return;
+	}
+	early_panicking = 1;
+	a135f_early_string("\nA135F EARLY PANIC: ");
+	va_list copy;
+	va_copy(copy, *args);
+	_doprnt(fmt, &copy, a135f_early_putc, 16);
+	va_end(copy);
+	a135f_early_putc('\n');
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+a135f_early_relocate(uint64_t base)
+{
+	a135f_early_mark(8, "leaving bootstrap TTBR0");
+	early_fb = (volatile uint32_t *)(uintptr_t)base;
+	__asm__ volatile("dsb sy" ::: "memory");
+	a135f_early_mark(9, "kernel framebuffer VA live");
+}
+
+void
+a135f_early_disable(void)
+{
+	early_disabled = 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+#endif /* A135F */
diff --git a/osfmk/arm64/a135f_early.h b/osfmk/arm64/a135f_early.h
new file mode 100644
index 0000000..6420ac9
--- /dev/null
+++ b/osfmk/arm64/a135f_early.h
@@ -0,0 +1,24 @@
+/* Screen diagnostics through bootstrap TTBR0 and the final kernel TTBR1. */
+#ifndef _ARM64_A135F_EARLY_H_
+#define _ARM64_A135F_EARLY_H_
+
+#include <pexpert/arm64/board_config.h>
+#include <stdarg.h>
+#include <stdint.h>
+
+#if defined(A135F)
+void a135f_early_mark(unsigned int stage, const char *label);
+void a135f_early_putc(char c);
+void a135f_early_panic(const char *fmt, va_list *args);
+void a135f_early_relocate(uint64_t base);
+void a135f_early_disable(void);
+#else
+static inline void a135f_early_mark(unsigned int stage, const char *label)
+{
+	(void)stage;
+	(void)label;
+}
+static inline void a135f_early_disable(void) {}
+#endif
+
+#endif
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index d89b0f1..94bba40 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -41,6 +41,7 @@
 #include <machine/atomic.h>
 #include <arm64/proc_reg.h>
 #include <arm64/lowglobals.h>
+#include <arm64/a135f_early.h>
 #include <arm/cpu_data_internal.h>
 #include <arm/misc_protos.h>
 #include <pexpert/arm64/boot.h>
@@ -1812,6 +1813,44 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
 #define ARM64_PHYSMAP_SLIDE_RANGE (1ULL << 30) // 1 GB
 #define ARM64_PHYSMAP_SLIDE_MASK  (ARM64_PHYSMAP_SLIDE_RANGE - 1)
 
+#if XNU_MONITOR
+#define ARM64_PHYSMAP_ALIGNMENT_PADDING 0ULL
+#else
+/*
+ * arm_vm_physmap_slide() preserves each PA's block offset. Each PTOV entry
+ * can therefore consume up to one extra twig of VA space. Reserve that
+ * space in both the aperture bound and its L1 allocation, including the
+ * ARM_LARGE_MEMORY configuration used by A135F's non-PPL kernel.
+ */
+#define ARM64_PHYSMAP_ALIGNMENT_PADDING (PTOV_TABLE_SIZE * ARM_TT_TWIG_SIZE)
+#endif
+
+#if defined(A135F)
+/*
+ * The reserved low-globals/kernel region is excluded from VM allocation.
+ * Use the otherwise empty 32MB block above low globals and below gVirtBase
+ * for a Normal-NC framebuffer alias that survives bootstrap TTBR0 teardown.
+ */
+#define A135F_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
+
+static void
+a135f_early_map_final(void)
+{
+	const vm_map_address_t va = A135F_EARLY_FB_VA;
+	assert(va + ARM_TT_L2_SIZE <= gVirtBase);
+	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
+	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
+	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
+	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
+	assert(*slot == ARM_TTE_EMPTY);
+	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	__asm__ volatile("dsb ishst" ::: "memory");
+}
+#endif
+
 void
 arm_vm_init(uint64_t memory_size, boot_args * args)
 {
@@ -1859,7 +1898,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	}
 
 #if defined(ARM_LARGE_MEMORY)
-	unsigned long physmap_l1_entries = ((real_phys_size + ARM64_PHYSMAP_SLIDE_RANGE) >> ARM_TT_L1_SHIFT) + 1;
+	unsigned long physmap_l1_entries = ((real_phys_size + ARM64_PHYSMAP_SLIDE_RANGE + ARM64_PHYSMAP_ALIGNMENT_PADDING) >> ARM_TT_L1_SHIFT) + 1;
 	physmap_base = VM_MIN_KERNEL_ADDRESS - (physmap_l1_entries << ARM_TT_L1_SHIFT);
 #else
 	physmap_base = phystokv(args->topOfKernelData);
@@ -1883,10 +1922,10 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 #if defined(ARM_LARGE_MEMORY)
 	/* For large memory systems with no PPL such as virtual machines */
 	static_memory_end = phystokv(args->topOfKernelData);
-	physmap_end = physmap_base + real_phys_size;
+	physmap_end = physmap_base + real_phys_size + ARM64_PHYSMAP_ALIGNMENT_PADDING;
 #else
-	static_memory_end = physmap_base + mem_size + (PTOV_TABLE_SIZE * ARM_TT_TWIG_SIZE); // worst possible case for block alignment
-	physmap_end = physmap_base + real_phys_size + (PTOV_TABLE_SIZE * ARM_TT_TWIG_SIZE);
+	static_memory_end = physmap_base + mem_size + ARM64_PHYSMAP_ALIGNMENT_PADDING; // worst possible case for block alignment
+	physmap_end = physmap_base + real_phys_size + ARM64_PHYSMAP_ALIGNMENT_PADDING;
 #endif // ARM_LARGE_MEMORY
 #endif
 
@@ -2140,18 +2179,28 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 
 	arm_set_user_tbi();
 
+#if defined(A135F)
+	/* phystokv() must still refer to the bootstrap aperture here. */
+	a135f_early_map_final();
+#endif
 	arm_vm_physmap_init(args);
 	set_mmu_ttb_alternate(cpu_ttep & TTBR_BADDR_MASK);
 
 	ml_enable_monitor();
 
+#if defined(A135F)
+	/* The final TTBR1 is live; leave the outgoing VA=PA framebuffer alias. */
+	a135f_early_relocate(A135F_EARLY_FB_VA);
+#endif
 	set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
 
 	flush_mmu_tlb();
+	a135f_early_mark(10, "TTBR0 off; TLB flushed");
 	kva_active = TRUE;
 	// global table pointers may need to be different due to physical aperture remapping
 	cpu_tte = (tt_entry_t*)(phystokv(cpu_ttep));
 	invalid_tte = (tt_entry_t*)(phystokv(invalid_ttep));
+	a135f_early_mark(11, "physmap table pointers rebound");
 
 	// From here on out, we're off the bootstrap translation tables.
 
@@ -2244,7 +2293,9 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
     }
 #endif
 #endif
+	a135f_early_mark(12, "calling pmap_bootstrap");
 	pmap_bootstrap(dynamic_memory_begin);
+	a135f_early_mark(13, "pmap_bootstrap done");
 
 	disable_preemption();
 
@@ -2295,6 +2346,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 		va_l1 = va_l2_end;
 		cpu_l1_tte++;
 	}
+	a135f_early_mark(14, "early I/O page tables ready");
 
 #if defined(KERNEL_INTEGRITY_KTRR) || defined(KERNEL_INTEGRITY_CTRR)
 	/*
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index bab080b..7c7ec7a 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -463,6 +463,25 @@ LEXT(start_first_cpu)
 	mov		x20, x0
 	mov		x21, #0
 
+#if defined(A135F)
+	/* Stage 0: white 64x32 band, no stack or page tables needed. */
+	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	mov		w1, #-1
+	mov		x2, #32
+	mov		x4, #4320
+La135f_mark_row:
+	mov		x3, #64
+	mov		x5, x0
+La135f_mark_pixel:
+	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	La135f_mark_pixel
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	La135f_mark_row
+	dsb		sy
+#endif
+
 	// Set low reset vector before attempting any loads
 	adrp	x0, EXT(LowExceptionVectorBase)@page
 	add		x0, x0, EXT(LowExceptionVectorBase)@pageoff
@@ -609,6 +628,23 @@ Lkernelcache_base_found:
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
+#if defined(A135F)
+	/*
+	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P
+	 * L2 table. Both framebuffer and RAM use L1 index 0; another call to
+	 * create_bootstrap_mapping would replace the RAM L2 table.
+	 * A135F uses 16K pages and all bring-up RAM is below 4GB, so the first
+	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
+	 */
+	MOV64	x10, 0x9c000000
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x11, x11, x10
+	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
+	add		x13, x25, #(2 * PGBYTES)
+	str		x11, [x13, x12, lsl #TTE_SHIFT]
+#endif
+
 	/* Ensure TTEs are visible */
 	dsb		ish
 
